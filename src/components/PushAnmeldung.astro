---
/**
 * Ein- und Ausschalter für Push-Benachrichtigungen bei neuen Veranstaltungen.
 *
 * Ohne JavaScript oder in einem Browser ohne Push-Unterstützung bleibt der
 * Abschnitt unsichtbar (hidden am Container) – ein Knopf, der nichts tun kann,
 * hilft niemandem.
 *
 * Ablauf beim Einschalten:
 *   1. öffentlichen VAPID-Schlüssel von /api/push.php?aktion=schluessel holen
 *   2. Erlaubnis für Benachrichtigungen erfragen
 *   3. /sw.js registrieren und beim Push-Dienst des Browsers abonnieren
 *   4. das Abonnement an /api/push.php (aktion=anmelden) schicken
 *
 * Gespeichert werden die Abonnements auf dem Server, versendet werden sie nach
 * einem Deploy vom Workflow .github/workflows/veranstaltung-melden.yml.
 */

interface Props {
  /** Serverseitiger Endpunkt, der die Abonnements verwaltet. */
  aktion?: string;
  titel?: string;
  text?: string;
}

const {
  aktion = '/api/push.php',
  titel = 'Keine Veranstaltung verpassen',
  text = 'Wir schicken Ihnen eine kurze Mitteilung aufs Handy, sobald eine neue Veranstaltung am Hegerberg feststeht. Höchstens ein paar Mal im Jahr, jederzeit wieder abschaltbar.',
} = Astro.props;
---

<div class="card p-6 sm:p-8" data-push={aktion} hidden>
  <p class="eyebrow">Benachrichtigungen</p>
  <h2 class="mt-2 text-xl font-bold text-holz-950">{titel}</h2>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-holz-700">{text}</p>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="button" class="btn-primary" data-push-knopf hidden></button>

    <p
      class="text-sm font-semibold"
      data-push-meldung
      role="status"
      aria-live="polite"
      hidden
    >
    </p>
  </div>

  <p class="mt-4 text-xs leading-relaxed text-holz-500">
    Es wird nur die technische Adresse Ihres Browsers gespeichert – kein Name,
    keine E-Mail-Adresse. Nähere Angaben in der
    <a href="/datenschutz/" class="underline hover:text-holz-700"
      >Datenschutzerklärung</a
    >.
  </p>
</div>

<script>
  const MELDUNG_FEHLER =
    'Das hat leider nicht geklappt. Bitte versuchen Sie es später noch einmal.';
  const MELDUNG_BLOCKIERT =
    'Benachrichtigungen sind für diese Seite in den Browser-Einstellungen gesperrt. Bitte dort wieder erlauben.';
  const MELDUNG_ABGELEHNT =
    'Ohne Erlaubnis des Browsers können wir nichts schicken.';
  const MELDUNG_IOS =
    'Auf iPhone und iPad funktionieren Benachrichtigungen nur, wenn die Seite auf dem Home-Bildschirm liegt: unten auf „Teilen“ tippen, dann „Zum Home-Bildschirm“ – und dort erneut einschalten.';

  /**
   * Der applicationServerKey muss als Bytefolge übergeben werden, der Server
   * liefert ihn base64url-codiert.
   */
  function schluesselAlsBytes(base64url: string) {
    const base64 = (base64url + '='.repeat((4 - (base64url.length % 4)) % 4))
      .replace(/-/g, '+')
      .replace(/_/g, '/');
    const roh = atob(base64);

    const bytes = new Uint8Array(roh.length);
    for (let i = 0; i < roh.length; i++) bytes[i] = roh.charCodeAt(i);

    return bytes;
  }

  /** Kurzer Aufruf des PHP-Endpunkts, wirft bei allem außer 2xx. */
  async function senden(
    endpunkt: string,
    nutzlast: Record<string, unknown>,
  ): Promise<Record<string, unknown>> {
    const antwort = await fetch(endpunkt, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(nutzlast),
    });

    if (!antwort.ok) throw new Error(`Endpunkt antwortete mit ${antwort.status}`);

    return (await antwort.json()) as Record<string, unknown>;
  }

  /**
   * Auf iOS gibt es PushManager ausschließlich in der installierten Fassung –
   * dort lohnt sich der Hinweis, wie sich das nachholen lässt.
   */
  function istApfelGeraet(): boolean {
    return (
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      // iPadOS meldet sich seit Version 13 als Mac mit Touchscreen.
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
    );
  }

  for (const behaelter of document.querySelectorAll<HTMLElement>('[data-push]')) {
    const endpunkt = behaelter.dataset.push ?? '/api/push.php';
    const knopf = behaelter.querySelector<HTMLButtonElement>('[data-push-knopf]');
    const meldung = behaelter.querySelector<HTMLElement>('[data-push-meldung]');
    if (!knopf || !meldung) continue;

    behaelter.hidden = false;

    const zeigeMeldung = (text: string | null, erfolg = false) => {
      meldung.textContent = text ?? '';
      meldung.classList.toggle('text-wald-700', erfolg);
      meldung.classList.toggle('text-red-700', !erfolg);
      meldung.hidden = !text;
    };

    const unterstuetzt =
      'serviceWorker' in navigator &&
      'PushManager' in window &&
      'Notification' in window;

    if (!unterstuetzt) {
      zeigeMeldung(
        istApfelGeraet()
          ? MELDUNG_IOS
          : 'Ihr Browser unterstützt keine Benachrichtigungen.',
      );
      continue;
    }

    if (Notification.permission === 'denied') {
      zeigeMeldung(MELDUNG_BLOCKIERT);
      continue;
    }

    knopf.hidden = false;

    /** Knopfbeschriftung und Stil an den aktuellen Zustand anpassen. */
    const zeigeZustand = (an: boolean) => {
      knopf.textContent = an
        ? 'Benachrichtigungen abschalten'
        : 'Benachrichtigungen einschalten';
      knopf.classList.toggle('btn-primary', !an);
      knopf.classList.toggle('btn-outline', an);
      knopf.dataset.pushAn = an ? 'ja' : 'nein';
    };

    /** Registrierung des Service Workers – beim ersten Mal legt sie ihn an. */
    const registrierung = async () =>
      (await navigator.serviceWorker.getRegistration('/sw.js')) ??
      (await navigator.serviceWorker.register('/sw.js', { scope: '/' }));

    const einschalten = async () => {
      const erlaubnis = await Notification.requestPermission();
      if (erlaubnis !== 'granted') {
        zeigeMeldung(
          erlaubnis === 'denied' ? MELDUNG_BLOCKIERT : MELDUNG_ABGELEHNT,
        );
        return false;
      }

      const antwort = await fetch(`${endpunkt}?aktion=schluessel`, {
        headers: { Accept: 'application/json' },
      });
      const { schluessel } = (await antwort.json()) as { schluessel?: string };
      if (!antwort.ok || !schluessel) throw new Error('Kein VAPID-Schlüssel erhalten.');

      const abo = await (
        await registrierung()
      ).pushManager.subscribe({
        // Pflicht in allen Browsern: Jede Nachricht muss sichtbar sein.
        userVisibleOnly: true,
        applicationServerKey: schluesselAlsBytes(schluessel),
      });

      const ergebnis = await senden(endpunkt, {
        aktion: 'anmelden',
        abo: abo.toJSON(),
      });

      zeigeMeldung(
        typeof ergebnis.meldung === 'string'
          ? ergebnis.meldung
          : 'Benachrichtigungen sind aktiviert.',
        true,
      );

      return true;
    };

    const abschalten = async () => {
      const abo = await (await registrierung()).pushManager.getSubscription();
      if (!abo) return false;

      // Erst beim Server abmelden: Schlägt das fehl, bleibt das Abonnement im
      // Browser bestehen und der nächste Versuch kann es erneut probieren.
      await senden(endpunkt, { aktion: 'abmelden', endpunkt: abo.endpoint });
      await abo.unsubscribe();

      zeigeMeldung('Benachrichtigungen sind abgeschaltet.', true);

      return false;
    };

    knopf.addEventListener('click', async () => {
      const war = knopf.dataset.pushAn === 'ja';
      knopf.disabled = true;
      zeigeMeldung(null);

      try {
        zeigeZustand(war ? await abschalten() : await einschalten());
      } catch (fehler) {
        console.error('Push:', fehler);
        zeigeMeldung(MELDUNG_FEHLER);
        zeigeZustand(war);
      } finally {
        knopf.disabled = false;
      }
    });

    // Startzustand: Ein Abonnement im Browser zählt nur, wenn der Server es
    // auch kennt – abgelaufene Abonnements räumt push-versand.php dort weg.
    void (async () => {
      zeigeZustand(false);

      try {
        const vorhanden = await navigator.serviceWorker.getRegistration('/sw.js');
        const abo = await vorhanden?.pushManager.getSubscription();
        if (!abo) return;

        const { bekannt } = (await senden(endpunkt, {
          aktion: 'pruefen',
          endpunkt: abo.endpoint,
        })) as { bekannt?: boolean };

        // Kennt der Server das Abonnement nicht mehr, wird es stillschweigend
        // wieder eingetragen – für die Besucher:innen war es ja nie aus.
        if (!bekannt) {
          await senden(endpunkt, { aktion: 'anmelden', abo: abo.toJSON() });
        }

        zeigeZustand(true);
      } catch (fehler) {
        console.error('Push:', fehler);
      }
    })();
  }
</script>
