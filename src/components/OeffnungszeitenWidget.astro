---
import {
  getOeffnungszeiten,
  zeitspanne,
  type OeffnungstagData,
} from '../lib/oeffnungszeiten';

interface Props {
  /** "kompakt" für die Startseite, "voll" für die Öffnungszeiten-Seite. */
  variante?: 'kompakt' | 'voll';
  class?: string;
}

const { variante = 'kompakt', class: klasse } = Astro.props;

const tage: OeffnungstagData[] = await getOeffnungszeiten();
const hinweise = [
  ...new Set(tage.map((tag) => tag.hinweis).filter(Boolean)),
] as string[];
---

<section
  class:list={['card overflow-hidden', klasse]}
  data-oeffnungszeiten
  aria-labelledby="oeffnungszeiten-titel"
>
  <div class="bg-wald-800 px-6 py-5 text-holz-50 sm:px-8">
    <p class="eyebrow text-wald-200">Immer aktuell</p>
    <h2
      id="oeffnungszeiten-titel"
      class="mt-1 text-2xl font-bold sm:text-3xl"
    >
      Öffnungszeiten
    </h2>

    <!-- Wird clientseitig befüllt; ohne JS bleibt der statische Fallback stehen. -->
    <div
      class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1"
      data-status
      hidden
    >
      <span class="flex items-center gap-2 text-base font-semibold">
        <span
          class="size-2.5 shrink-0 rounded-full bg-holz-400"
          data-status-punkt
          aria-hidden="true"></span>
        <span data-status-text></span>
      </span>
      <span class="text-sm text-wald-200" data-status-detail></span>
    </div>
  </div>

  <dl class="divide-y divide-holz-200">
    {
      tage.map((tag) => (
        <div
          class="flex items-baseline justify-between gap-4 px-6 py-3 sm:px-8"
          data-tag={tag.tag}
        >
          <dt class="font-medium">
            {tag.tag}
            {tag.hinweis && variante === 'voll' && (
              <span class="mt-0.5 block text-xs font-normal text-holz-600">
                {tag.hinweis}
              </span>
            )}
          </dt>
          <dd
            class:list={[
              'shrink-0 tabular-nums',
              tag.geschlossen ? 'text-holz-500' : 'font-semibold',
            ]}
          >
            {zeitspanne(tag)}
          </dd>
        </div>
      ))
    }
  </dl>

  {
    hinweise.length > 0 && variante === 'kompakt' && (
      <div class="border-t border-holz-200 bg-holz-100 px-6 py-4 text-sm text-holz-700 sm:px-8">
        <ul class="space-y-1">
          {hinweise.map((hinweis) => (
            <li>{hinweis}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<script
  type="application/json"
  data-oeffnungszeiten-daten
  set:html={JSON.stringify(tage)}
  is:inline
/>

<script>
  type Tag = {
    tag: string;
    reihenfolge: number;
    geschlossen: boolean;
    von?: string;
    bis?: string;
    hinweis?: string;
  };

  const datenEl = document.querySelector<HTMLScriptElement>(
    '[data-oeffnungszeiten-daten]',
  );
  if (datenEl) {
    const tage: Tag[] = JSON.parse(datenEl.textContent ?? '[]');
    const reihenfolge = [...tage].sort((a, b) => a.reihenfolge - b.reihenfolge);

    const minuten = (hhmm: string) => {
      const [h, m] = hhmm.split(':').map(Number);
      return h * 60 + m;
    };

    /** Aktuelle Wiener Zeit unabhängig von der Zeitzone des Besuchers. */
    const jetztInWien = () => {
      const teile = new Intl.DateTimeFormat('de-AT', {
        timeZone: 'Europe/Vienna',
        weekday: 'long',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(new Date());
      const wert = (typ: string) =>
        teile.find((p) => p.type === typ)?.value ?? '';
      return {
        wochentag: wert('weekday'),
        minuten: Number(wert('hour')) * 60 + Number(wert('minute')),
      };
    };

    const istOffen = (tag: Tag | undefined) =>
      Boolean(tag && !tag.geschlossen && tag.von && tag.bis);

    const aktualisiere = () => {
      const jetzt = jetztInWien();
      const index = reihenfolge.findIndex((t) => t.tag === jetzt.wochentag);
      if (index === -1) return;

      const heute = reihenfolge[index];
      const gestern = reihenfolge[(index + reihenfolge.length - 1) % reihenfolge.length];

      let offen = false;
      let detail = '';

      // Gestern über Mitternacht hinaus geöffnet?
      if (istOffen(gestern)) {
        const von = minuten(gestern.von!);
        const bis = minuten(gestern.bis!);
        if (bis <= von && jetzt.minuten < bis) {
          offen = true;
          detail = `Noch bis ${gestern.bis} Uhr`;
        }
      }

      if (!offen && istOffen(heute)) {
        const von = minuten(heute.von!);
        let bis = minuten(heute.bis!);
        if (bis <= von) bis += 24 * 60;

        if (jetzt.minuten >= von && jetzt.minuten < bis) {
          offen = true;
          const restMinuten = bis - jetzt.minuten;
          detail =
            restMinuten <= 60
              ? `Schließt in ${restMinuten} Min. (${heute.bis} Uhr)`
              : `Heute bis ${heute.bis} Uhr`;
        } else if (jetzt.minuten < von) {
          detail = `Öffnet heute um ${heute.von} Uhr`;
        }
      }

      if (!offen && !detail) {
        // Nächsten geöffneten Tag suchen.
        for (let versatz = 1; versatz <= reihenfolge.length; versatz++) {
          const kandidat = reihenfolge[(index + versatz) % reihenfolge.length];
          if (istOffen(kandidat)) {
            detail =
              versatz === 1
                ? `Öffnet morgen um ${kandidat.von} Uhr`
                : `Öffnet ${kandidat.tag} um ${kandidat.von} Uhr`;
            break;
          }
        }
      }

      const heuteHinweis = heute?.hinweis;
      if (!offen && heuteHinweis) {
        detail = detail ? `${heuteHinweis} · ${detail}` : heuteHinweis;
      }

      for (const widget of document.querySelectorAll('[data-oeffnungszeiten]')) {
        const status = widget.querySelector<HTMLElement>('[data-status]');
        const punkt = widget.querySelector<HTMLElement>('[data-status-punkt]');
        const text = widget.querySelector<HTMLElement>('[data-status-text]');
        const detailEl = widget.querySelector<HTMLElement>('[data-status-detail]');
        if (!status || !punkt || !text || !detailEl) continue;

        status.hidden = false;
        text.textContent = offen ? 'Jetzt geöffnet' : 'Derzeit geschlossen';
        detailEl.textContent = detail;
        punkt.className = `size-2.5 shrink-0 rounded-full ${
          offen ? 'bg-green-400' : 'bg-red-400'
        }`;

        // Heutige Zeile hervorheben.
        for (const zeile of widget.querySelectorAll<HTMLElement>('[data-tag]')) {
          zeile.classList.toggle(
            'bg-holz-100',
            zeile.dataset.tag === jetzt.wochentag,
          );
        }
      }
    };

    aktualisiere();
    setInterval(aktualisiere, 60_000);
  }
</script>
