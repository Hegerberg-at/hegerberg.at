---
import type { Profilpunkt } from '../lib/gpx';

interface Props {
  profil: Profilpunkt[];
  hoeheMin: number;
  hoeheMax: number;
  distanzKm: number;
  /** Überschriftsebene für die Beschriftung, falls gebraucht. */
  titel?: string;
}

const { profil, hoeheMin, hoeheMax, distanzKm, titel } = Astro.props;

const BREITE = 800;
const HOEHE = 220;
const RAND = { oben: 16, rechts: 8, unten: 28, links: 44 };

// Der Wertebereich wird auf glatte 50er gerundet, damit die Gitterlinien
// runde Höhen zeigen.
const untenM = Math.floor(hoeheMin / 50) * 50;
const obenM = Math.ceil(hoeheMax / 50) * 50;
const spanne = Math.max(obenM - untenM, 50);

const innenBreite = BREITE - RAND.links - RAND.rechts;
const innenHoehe = HOEHE - RAND.oben - RAND.unten;

const x = (km: number) => RAND.links + (km / Math.max(distanzKm, 0.1)) * innenBreite;
const y = (ele: number) => RAND.oben + (1 - (ele - untenM) / spanne) * innenHoehe;

const linie = profil
  .map((punkt, index) => `${index === 0 ? 'M' : 'L'}${x(punkt.km).toFixed(1)},${y(punkt.ele).toFixed(1)}`)
  .join(' ');

const flaeche = `${linie} L${x(profil[profil.length - 1].km).toFixed(1)},${(HOEHE - RAND.unten).toFixed(1)} L${x(profil[0].km).toFixed(1)},${(HOEHE - RAND.unten).toFixed(1)} Z`;

/** 3–5 Gitterlinien, je nach Höhenunterschied. */
const schrittM = spanne <= 150 ? 50 : spanne <= 400 ? 100 : 200;
const hoehenlinien: number[] = [];
for (let wert = untenM; wert <= obenM; wert += schrittM) hoehenlinien.push(wert);

const kmSchritt = distanzKm <= 6 ? 1 : distanzKm <= 15 ? 2 : 5;
const kmMarken: number[] = [];
for (let wert = 0; wert <= distanzKm; wert += kmSchritt) kmMarken.push(wert);

const beschriftung = titel
  ? `Höhenprofil: ${titel}`
  : 'Höhenprofil der Tour';
---

<figure class="card overflow-hidden p-4 sm:p-6">
  <figcaption class="text-sm font-semibold text-holz-900">Höhenprofil</figcaption>
  <svg
    viewBox={`0 0 ${BREITE} ${HOEHE}`}
    class="mt-3 h-auto w-full"
    role="img"
    aria-label={`${beschriftung} – von ${hoeheMin} bis ${hoeheMax} Meter auf ${distanzKm.toLocaleString('de-AT', { maximumFractionDigits: 1 })} Kilometern.`}
  >
    <defs>
      <linearGradient id="profil-verlauf" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4c7c52" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="#4c7c52" stop-opacity="0.05"></stop>
      </linearGradient>
    </defs>

    {
      hoehenlinien.map((wert) => (
        <g>
          <line
            x1={RAND.links}
            x2={BREITE - RAND.rechts}
            y1={y(wert)}
            y2={y(wert)}
            stroke="#e4d2ba"
            stroke-width="1"
          />
          <text
            x={RAND.links - 8}
            y={y(wert) + 4}
            text-anchor="end"
            font-size="11"
            fill="#7a4c32"
          >
            {wert}
          </text>
        </g>
      ))
    }

    {
      kmMarken.map((wert) => (
        <text
          x={x(wert)}
          y={HOEHE - 8}
          text-anchor={wert === 0 ? 'start' : 'middle'}
          font-size="11"
          fill="#7a4c32"
        >
          {wert} km
        </text>
      ))
    }

    <path d={flaeche} fill="url(#profil-verlauf)"></path>
    <path
      d={linie}
      fill="none"
      stroke="#2e4f34"
      stroke-width="2.5"
      stroke-linejoin="round"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>

  <p class="mt-2 text-xs text-holz-600">
    Tiefster Punkt {hoeheMin} m · höchster Punkt {hoeheMax} m
  </p>
</figure>
