---
import { navigation, site } from "../lib/site";
import { getOpeningHours, timeRange } from "../lib/opening-hours";

const days = await getOpeningHours();
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-wood-950 text-wood-200">
  <div class="container-page grid gap-12 py-16 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold text-wood-50">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-wood-300">
        {site.claim} – {site.geo.elevation} m Seehöhe, Bezirk {
          site.address.district
        }.
      </p>
      <div class="mt-6 flex gap-3">
        {
          site.social.facebook && (
            <a
              href={site.social.facebook}
              rel="noopener noreferrer"
              target="_blank"
              class="rounded-full border border-wood-50/20 px-4 py-2 text-xs font-semibold transition hover:bg-wood-50/10"
            >
              Facebook
            </a>
          )
        }
        {
          site.social.instagram && (
            <a
              href={site.social.instagram}
              rel="noopener noreferrer"
              target="_blank"
              class="rounded-full border border-wood-50/20 px-4 py-2 text-xs font-semibold transition hover:bg-wood-50/10"
            >
              Instagram
            </a>
          )
        }
        {
          site.social.github && (
            <a
              href={site.social.github}
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-2 rounded-full border border-wood-50/20 px-4 py-2 text-xs font-semibold transition hover:bg-wood-50/10"
            >
              {/* GitHub mark, from the official octicons set. */}
              <svg
                class="size-4"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              Quellcode auf GitHub
            </a>
          )
        }
      </div>
    </div>

    <div>
      <h2
        class="text-sm font-semibold uppercase tracking-[0.2em] text-wood-400"
      >
        Kontakt
      </h2>
      <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed">
        <p>{site.address.street}</p>
        <p>
          {site.address.postalCode}&nbsp;{site.address.city}, {
            site.address.country
          }
        </p>
        <p class="pt-3">
          <a
            href={`tel:${site.phone.replace(/\s/g, "")}`}
            class="transition hover:text-wood-50">{site.phoneDisplay}</a
          >
        </p>
        <p>
          <a href={`mailto:${site.email}`} class="transition hover:text-wood-50"
            >{site.email}</a
          >
        </p>
      </address>

      <h2
        class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-wood-400"
      >
        Navigation
      </h2>
      <ul class="mt-4 space-y-1 text-sm">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="transition hover:text-wood-50">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2
        class="text-sm font-semibold uppercase tracking-[0.2em] text-wood-400"
      >
        Öffnungszeiten
      </h2>
      <dl class="mt-4 space-y-1 text-sm">
        {
          days.map((day) => (
            <div class="flex justify-between gap-4 border-b border-wood-50/10 py-1.5 last:border-0">
              <dt>{day.day}</dt>
              <dd
                class:list={[
                  "tabular-nums",
                  day.closed ? "text-wood-400" : "text-wood-50",
                ]}
              >
                {timeRange(day)}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-wood-50/10">
    <div
      class="container-page flex flex-col gap-3 py-6 text-xs text-wood-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p>&copy; {year} {site.name}. Alle Rechte vorbehalten.</p>
        <p>
          Author <a
            href="https://github.com/stefanschlipfi"
            rel="noopener noreferrer"
            target="_blank"
            class="transition hover:text-wood-100">@Stefan Schlipfinger</a
          >
        </p>
      </div>
      <nav aria-label="Rechtliches" class="flex items-center gap-5">
        <a href="/impressum/" class="transition hover:text-wood-100"
          >Impressum</a
        >
        <a href="/datenschutz/" class="transition hover:text-wood-100"
          >Datenschutz</a
        >
        <a
          href="/admin/"
          rel="nofollow"
          class="text-wood-600 transition hover:text-wood-300"
          title="Inhalte bearbeiten">Redaktion</a
        >
      </nav>
    </div>
  </div>
</footer>
