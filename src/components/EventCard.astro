---
import { formatDatum, formatDatumKurz, isoDatum } from '../lib/format';

interface Props {
  titel: string;
  datum: Date;
  datumBis?: Date;
  uhrzeit?: string;
  beschreibung: string;
  bild?: string;
  bildAlt?: string;
  abgesagt?: boolean;
  /** Ziel der Detailseite. Ohne Angabe bleibt die Kachel nicht klickbar. */
  href?: string;
}

const {
  titel,
  datum,
  datumBis,
  uhrzeit,
  beschreibung,
  bild,
  bildAlt,
  abgesagt = false,
  href,
} = Astro.props;

const datumsText = datumBis
  ? `${formatDatumKurz(datum)} – ${formatDatumKurz(datumBis)}`
  : formatDatum(datum);
---

<article
  class:list={[
    'card group relative flex flex-col overflow-hidden transition',
    abgesagt && 'opacity-70',
    href && 'hover:-translate-y-1 hover:shadow-lg focus-within:shadow-lg',
  ]}
>
  {
    bild ? (
      <img
        src={bild}
        alt={bildAlt ?? ''}
        loading="lazy"
        decoding="async"
        class="w-full object-cover"
      />
    ) : (
      <div
        class="aspect-[16/10] w-full bg-gradient-to-br from-wald-700 to-holz-800"
        aria-hidden="true"
      />
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-wald-700">
      <time datetime={isoDatum(datum)}>{datumsText}</time>
      {uhrzeit && <span class="text-holz-600">· {uhrzeit} Uhr</span>}
    </p>

    <h3 class="mt-2 text-xl font-bold text-holz-950">
      {abgesagt && <span class="text-red-700">Abgesagt: </span>}
      {
        href ? (
          <a
            href={href}
            class="after:absolute after:inset-0 after:content-[''] group-hover:text-wald-800"
          >
            {titel}
          </a>
        ) : (
          titel
        )
      }
    </h3>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-holz-700">
      {beschreibung}
    </p>

    {
      href && (
        <p class="mt-4 text-sm font-semibold text-wald-700">
          Details ansehen
          <span aria-hidden="true" class="ml-1 inline-block transition group-hover:translate-x-1">
            →
          </span>
        </p>
      )
    }
  </div>
</article>
