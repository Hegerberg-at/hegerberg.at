---
import 'leaflet/dist/leaflet.css';

interface Props {
  /** Vereinfachter Linienzug [lat, lng]. */
  linie: [number, number][];
  bounds: [[number, number], [number, number]];
  titel: string;
  rundtour: boolean;
  /** Öffentlicher Pfad der GPX-Datei für den Download-Link. */
  gpx: string;
}

const { linie, bounds, titel, rundtour, gpx } = Astro.props;

const mitte: [number, number] = [
  (bounds[0][0] + bounds[1][0]) / 2,
  (bounds[0][1] + bounds[1][1]) / 2,
];
const osmLink = `https://www.openstreetmap.org/#map=14/${mitte[0].toFixed(5)}/${mitte[1].toFixed(5)}`;
---

<div class="card overflow-hidden">
  <div
    data-tourkarte
    data-linie={JSON.stringify(linie)}
    data-bounds={JSON.stringify(bounds)}
    data-titel={titel}
    data-rundtour={rundtour ? 'ja' : 'nein'}
    class="z-0 relative h-[22rem] w-full bg-holz-100 sm:h-[30rem]"
  >
    <noscript>
      <div class="grid h-full place-items-center p-6 text-center text-sm text-holz-700">
        Für die interaktive Karte wird JavaScript benötigt.
        <a href={gpx} download class="mt-2 block font-semibold text-wald-700 underline">
          GPX-Datei herunterladen
        </a>
      </div>
    </noscript>
    <p
      data-karte-platzhalter
      class="pointer-events-none absolute inset-0 grid place-items-center text-sm text-holz-600"
    >
      Karte wird geladen …
    </p>
  </div>

  <p class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-holz-200 px-4 py-3 text-xs text-holz-600">
    <span>Kartendaten © OpenStreetMap-Mitwirkende</span>
    <a
      href={osmLink}
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold text-wald-700 underline underline-offset-2"
    >
      In OpenStreetMap öffnen
    </a>
  </p>
</div>

<style>
  /* Leaflet setzt eigene Schriftgrößen – hier an die Seite angeglichen. */
  :global(.leaflet-container) {
    font-family: inherit;
    background: #f2e9dd;
  }

  :global(.leaflet-control-attribution) {
    font-size: 10px;
  }
</style>

<script>
  import L from 'leaflet';

  type Karte = HTMLElement & { dataset: DOMStringMap };

  const behaelter = document.querySelectorAll<Karte>('[data-tourkarte]');

  const baue = (element: Karte) => {
    const linie: [number, number][] = JSON.parse(element.dataset.linie ?? '[]');
    const bounds: [[number, number], [number, number]] = JSON.parse(
      element.dataset.bounds ?? 'null',
    );
    if (linie.length < 2 || !bounds) return;

    const karte = L.map(element, {
      // Scrollen über der Karte soll die Seite bewegen, nicht zoomen.
      scrollWheelZoom: false,
      attributionControl: true,
    });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(karte);

    // Weiße Kontur unter der Linie, damit sie auf jedem Untergrund lesbar ist.
    L.polyline(linie, { color: '#ffffff', weight: 8, opacity: 0.85 }).addTo(karte);
    const spur = L.polyline(linie, {
      color: '#2e4f34',
      weight: 4,
      opacity: 1,
      lineJoin: 'round',
    }).addTo(karte);
    spur.bindTooltip(element.dataset.titel ?? 'Tour', { sticky: true });

    const punktStil = {
      radius: 7,
      weight: 3,
      color: '#ffffff',
      fillOpacity: 1,
    };
    L.circleMarker(linie[0], { ...punktStil, fillColor: '#39623f' })
      .addTo(karte)
      .bindPopup(element.dataset.rundtour === 'ja' ? 'Start und Ziel' : 'Start');

    if (element.dataset.rundtour !== 'ja') {
      L.circleMarker(linie[linie.length - 1], { ...punktStil, fillColor: '#97613b' })
        .addTo(karte)
        .bindPopup('Ziel');
    }

    karte.fitBounds(bounds, { padding: [28, 28] });

    element.querySelector('[data-karte-platzhalter]')?.remove();

    // Erst nach einem Klick in die Karte zoomt das Mausrad.
    karte.on('click', () => karte.scrollWheelZoom.enable());
    karte.on('mouseout', () => karte.scrollWheelZoom.disable());
  };

  // Kacheln werden erst geladen, wenn die Karte tatsächlich sichtbar wird.
  const beobachter = new IntersectionObserver(
    (eintraege) => {
      for (const eintrag of eintraege) {
        if (!eintrag.isIntersecting) continue;
        beobachter.unobserve(eintrag.target);
        baue(eintrag.target as Karte);
      }
    },
    { rootMargin: '200px' },
  );

  for (const element of behaelter) beobachter.observe(element);
</script>
