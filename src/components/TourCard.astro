---
import type { TourData, TourType } from '../lib/gpx';
import { formatDuration, formatDistance } from '../lib/gpx';
import TourStats from './TourStats.astro';

interface Props {
  href: string;
  title: string;
  type: TourType;
  difficulty: 'leicht' | 'mittel' | 'schwer';
  description: string;
  image?: string;
  imageAlt?: string;
  data: TourData;
  durationMinutes: number;
}

const {
  href,
  title,
  type,
  difficulty,
  description,
  image,
  imageAlt,
  data,
  durationMinutes,
} = Astro.props;

/**
 * Outline of the tour as a preview. For the small area a flat approximation is
 * enough: longitudes are compressed by the cosine of the latitude.
 */
const [[south, west], [north, east]] = data.bounds;
const compression = Math.cos(((south + north) / 2) * (Math.PI / 180));
const spanX = Math.max((east - west) * compression, 1e-6);
const spanY = Math.max(north - south, 1e-6);
const size = Math.max(spanX, spanY);
const offsetX = (size - spanX) / 2;
const offsetY = (size - spanY) / 2;

const outline = data.line
  .map(([lat, lng], index) => {
    const x = (((lng - west) * compression + offsetX) / size) * 100;
    const y = 100 - (((lat - south) + offsetY) / size) * 100;
    return `${index === 0 ? 'M' : 'L'}${x.toFixed(2)},${y.toFixed(2)}`;
  })
  .join(' ');

const difficultyStyle = {
  leicht: 'bg-forest-100 text-forest-800',
  mittel: 'bg-wood-200 text-wood-900',
  schwer: 'bg-wood-800 text-wood-50',
}[difficulty];
---

<article class="card group flex flex-col overflow-hidden transition hover:shadow-lg">
  <a href={href} class="relative block aspect-[16/10] overflow-hidden bg-wood-100">
    {
      image ? (
        <img
          src={image}
          alt={imageAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <svg
          viewBox="-6 -6 112 112"
          class="h-full w-full bg-gradient-to-br from-forest-50 to-wood-100"
          aria-hidden="true"
        >
          <path
            d={outline}
            fill="none"
            stroke="#ffffff"
            stroke-width="6"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          <path
            d={outline}
            fill="none"
            stroke="#2e4f34"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
        </svg>
      )
    }

    <span class="absolute left-3 top-3 flex flex-wrap gap-2">
      <span
        class="rounded-full bg-wood-950/85 px-3 py-1 text-xs font-semibold text-wood-50 backdrop-blur"
      >
        {type === 'Mountainbike' ? 'Mountainbike' : 'Wanderung'}
      </span>
      <span class:list={['rounded-full px-3 py-1 text-xs font-semibold', difficultyStyle]}>
        {difficulty}
      </span>
    </span>
  </a>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-wood-950">
      <a href={href} class="transition hover:text-forest-800">{title}</a>
    </h3>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-wood-700">{description}</p>

    <TourStats
      class="mt-5 border-t border-wood-200 pt-4"
      stats={[
        { label: 'Länge', value: formatDistance(data.distanceKm) },
        { label: 'Aufstieg', value: `${data.ascent} hm` },
        { label: 'Dauer', value: formatDuration(durationMinutes) },
      ]}
    />
  </div>
</article>
