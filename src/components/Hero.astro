---
import { site } from '../lib/site';

interface Props {
  /** Path to the banner image (in /public). SVG panorama by default. */
  image?: string;
  title?: string;
  subtitle?: string;
}

const {
  image = '/images/hero.svg',
  title = site.name,
  subtitle = site.claim,
} = Astro.props;
---

<section class="relative isolate -mt-[76px] flex min-h-[88svh] items-end">
  <img
    src={image}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-20 size-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-wood-950 via-wood-950/50 to-wood-950/25"
  >
  </div>

  <div class="container-page pb-20 pt-40 sm:pb-28">
    <p
      class="text-xs font-semibold uppercase tracking-[0.3em] text-wood-300 sm:text-sm"
    >
      {site.address.city} · {site.address.district} · {site.geo.elevation}&nbsp;m
    </p>
    <h1
      class="mt-5 max-w-3xl text-4xl font-bold leading-[1.05] text-wood-50 sm:text-6xl lg:text-7xl"
    >
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-wood-200 sm:text-xl">
      {subtitle}
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/oeffnungszeiten/" class="btn-primary">
        Öffnungszeiten ansehen
      </a>
      <a href="/kontakt/" class="btn-secondary"> Kontakt &amp; Anfahrt </a>
    </div>
  </div>
</section>
