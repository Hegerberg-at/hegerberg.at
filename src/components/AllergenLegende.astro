---
import { ALLERGENE } from '../lib/allergene';

interface Props {
  /** Nur die tatsächlich verwendeten Codes anzeigen. */
  codes?: string[];
}

const { codes } = Astro.props;
const eintraege = Object.entries(ALLERGENE).filter(
  ([code]) => !codes || codes.includes(code),
);
---

<section
  class="rounded-2xl border border-holz-200 bg-holz-100 p-6 sm:p-8"
  aria-labelledby="allergen-legende"
>
  <h2 id="allergen-legende" class="text-lg font-bold text-holz-950">
    Allergen-Kennzeichnung
  </h2>
  <p class="mt-2 text-sm text-holz-700">
    Gemäß österreichischer Allergeninformationsverordnung. Unser Personal
    informiert Sie gerne persönlich über die Zutaten unserer Speisen.
  </p>
  <dl
    class="mt-5 grid grid-cols-1 gap-x-8 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      eintraege.map(([code, bezeichnung]) => (
        <div class="flex gap-3">
          <dt class="w-5 shrink-0 font-bold text-wald-800">{code}</dt>
          <dd class="text-holz-700">{bezeichnung}</dd>
        </div>
      ))
    }
  </dl>
</section>
