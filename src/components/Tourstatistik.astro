---
interface Eintrag {
  label: string;
  wert: string;
}

interface Props {
  eintraege: Eintrag[];
  /** Zusätzliche Klassen für den umgebenden Block. */
  class?: string;
  /** Größere Darstellung für die Detailseite. */
  gross?: boolean;
}

const { eintraege, class: klasse, gross = false } = Astro.props;
---

<dl
  class:list={[
    'grid gap-4',
    gross ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-3',
    klasse,
  ]}
>
  {
    eintraege.map((eintrag) => (
      <div>
        <dt class="text-xs uppercase tracking-[0.14em] text-holz-500">
          {eintrag.label}
        </dt>
        <dd
          class:list={[
            'mt-1 font-semibold tabular-nums text-holz-950',
            gross ? 'text-lg sm:text-xl' : 'text-sm',
          ]}
        >
          {eintrag.wert}
        </dd>
      </div>
    ))
  }
</dl>
