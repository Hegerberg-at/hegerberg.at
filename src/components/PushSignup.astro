---
/**
 * Toggle for push notifications about new events.
 *
 * Without JavaScript, or in a browser without push support, the section stays
 * invisible (hidden on the container) – a button that cannot do anything helps
 * nobody.
 *
 * Steps when switching on:
 *   1. fetch the public VAPID key from /api/push.php?action=key
 *   2. ask for notification permission
 *   3. register /sw.js and subscribe with the browser's push service
 *   4. send the subscription to /api/push.php (action=subscribe)
 *
 * Subscriptions are stored on the server; they are sent out after a deploy by
 * the workflow .github/workflows/notify-event.yml.
 */

interface Props {
  /** Server-side endpoint that manages the subscriptions. */
  action?: string;
  title?: string;
  text?: string;
}

const {
  action = '/api/push.php',
  title = 'Keine Veranstaltung verpassen',
  text = 'Wir schicken Ihnen eine kurze Mitteilung aufs Handy, sobald eine neue Veranstaltung am Hegerberg feststeht. Höchstens ein paar Mal im Jahr, jederzeit wieder abschaltbar.',
} = Astro.props;
---

<div class="card p-6 sm:p-8" data-push={action} hidden>
  <p class="eyebrow">Benachrichtigungen</p>
  <h2 class="mt-2 text-xl font-bold text-wood-950">{title}</h2>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-wood-700">{text}</p>

  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="button" class="btn-primary" data-push-button hidden></button>

    <p
      class="text-sm font-semibold"
      data-push-message
      role="status"
      aria-live="polite"
      hidden
    >
    </p>
  </div>

  <p class="mt-4 text-xs leading-relaxed text-wood-500">
    Es wird nur die technische Adresse Ihres Browsers gespeichert – kein Name,
    keine E-Mail-Adresse. Nähere Angaben in der
    <a href="/datenschutz/" class="underline hover:text-wood-700"
      >Datenschutzerklärung</a
    >.
  </p>
</div>

<script>
  const MESSAGE_ERROR =
    'Das hat leider nicht geklappt. Bitte versuchen Sie es später noch einmal.';
  const MESSAGE_BLOCKED =
    'Benachrichtigungen sind für diese Seite in den Browser-Einstellungen gesperrt. Bitte dort wieder erlauben.';
  const MESSAGE_DENIED =
    'Ohne Erlaubnis des Browsers können wir nichts schicken.';
  const MESSAGE_IOS =
    'Auf iPhone und iPad funktionieren Benachrichtigungen nur, wenn die Seite auf dem Home-Bildschirm liegt: unten auf „Teilen“ tippen, dann „Zum Home-Bildschirm“ – und dort erneut einschalten.';

  /**
   * The applicationServerKey has to be passed as a byte sequence; the server
   * delivers it base64url encoded.
   */
  function keyAsBytes(base64url: string) {
    const base64 = (base64url + '='.repeat((4 - (base64url.length % 4)) % 4))
      .replace(/-/g, '+')
      .replace(/_/g, '/');
    const raw = atob(base64);

    const bytes = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);

    return bytes;
  }

  /** Short call to the PHP endpoint, throws on anything but 2xx. */
  async function send(
    endpoint: string,
    payload: Record<string, unknown>,
  ): Promise<Record<string, unknown>> {
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!response.ok) throw new Error(`Endpunkt antwortete mit ${response.status}`);

    return (await response.json()) as Record<string, unknown>;
  }

  /**
   * On iOS, PushManager only exists in the installed version – there the hint
   * how to catch up on that is worth showing.
   */
  function isAppleDevice(): boolean {
    return (
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      // Since version 13, iPadOS reports itself as a Mac with a touchscreen.
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
    );
  }

  for (const container of document.querySelectorAll<HTMLElement>('[data-push]')) {
    const endpoint = container.dataset.push ?? '/api/push.php';
    const button = container.querySelector<HTMLButtonElement>('[data-push-button]');
    const message = container.querySelector<HTMLElement>('[data-push-message]');
    if (!button || !message) continue;

    container.hidden = false;

    const showMessage = (text: string | null, success = false) => {
      message.textContent = text ?? '';
      message.classList.toggle('text-forest-700', success);
      message.classList.toggle('text-red-700', !success);
      message.hidden = !text;
    };

    const supported =
      'serviceWorker' in navigator &&
      'PushManager' in window &&
      'Notification' in window;

    if (!supported) {
      showMessage(
        isAppleDevice()
          ? MESSAGE_IOS
          : 'Ihr Browser unterstützt keine Benachrichtigungen.',
      );
      continue;
    }

    if (Notification.permission === 'denied') {
      showMessage(MESSAGE_BLOCKED);
      continue;
    }

    button.hidden = false;

    /** Adapt the button label and style to the current state. */
    const showState = (on: boolean) => {
      button.textContent = on
        ? 'Benachrichtigungen abschalten'
        : 'Benachrichtigungen einschalten';
      button.classList.toggle('btn-primary', !on);
      button.classList.toggle('btn-outline', on);
      button.dataset.pushOn = on ? 'yes' : 'no';
    };

    /** Service worker registration – the first call creates it. */
    const registration = async () =>
      (await navigator.serviceWorker.getRegistration('/sw.js')) ??
      (await navigator.serviceWorker.register('/sw.js', { scope: '/' }));

    const switchOn = async () => {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        showMessage(
          permission === 'denied' ? MESSAGE_BLOCKED : MESSAGE_DENIED,
        );
        return false;
      }

      const response = await fetch(`${endpoint}?action=key`, {
        headers: { Accept: 'application/json' },
      });
      const { key } = (await response.json()) as { key?: string };
      if (!response.ok || !key) throw new Error('Kein VAPID-Schlüssel erhalten.');

      const subscription = await (
        await registration()
      ).pushManager.subscribe({
        // Mandatory in every browser: each message has to be visible.
        userVisibleOnly: true,
        applicationServerKey: keyAsBytes(key),
      });

      const result = await send(endpoint, {
        action: 'subscribe',
        subscription: subscription.toJSON(),
      });

      showMessage(
        typeof result.message === 'string'
          ? result.message
          : 'Benachrichtigungen sind aktiviert.',
        true,
      );

      return true;
    };

    const switchOff = async () => {
      const subscription = await (await registration()).pushManager.getSubscription();
      if (!subscription) return false;

      // Unsubscribe on the server first: if that fails, the subscription stays
      // in the browser and the next attempt can try again.
      await send(endpoint, { action: 'unsubscribe', endpoint: subscription.endpoint });
      await subscription.unsubscribe();

      showMessage('Benachrichtigungen sind abgeschaltet.', true);

      return false;
    };

    button.addEventListener('click', async () => {
      const wasOn = button.dataset.pushOn === 'yes';
      button.disabled = true;
      showMessage(null);

      try {
        showState(wasOn ? await switchOff() : await switchOn());
      } catch (error) {
        console.error('Push:', error);
        showMessage(MESSAGE_ERROR);
        showState(wasOn);
      } finally {
        button.disabled = false;
      }
    });

    // Initial state: a subscription in the browser only counts when the server
    // knows about it too – push-send.php clears expired ones there.
    void (async () => {
      showState(false);

      try {
        const existing = await navigator.serviceWorker.getRegistration('/sw.js');
        const subscription = await existing?.pushManager.getSubscription();
        if (!subscription) return;

        const { known } = (await send(endpoint, {
          action: 'check',
          endpoint: subscription.endpoint,
        })) as { known?: boolean };

        // If the server no longer knows the subscription, it is silently
        // registered again – for the visitor it was never switched off.
        if (!known) {
          await send(endpoint, {
            action: 'subscribe',
            subscription: subscription.toJSON(),
          });
        }

        showState(true);
      } catch (error) {
        console.error('Push:', error);
      }
    })();
  }
</script>
