---
/**
 * Form for a membership request.
 *
 * Submission runs server side via /api/membership.php. With JavaScript the
 * input is validated up front with zod (src/lib/membership.ts) and sent via
 * fetch(); without JavaScript the plain POST plus redirect back to this page
 * takes over.
 */

interface Props {
  /** Server-side endpoint that sends the email. */
  action?: string;
  title?: string;
  text?: string;
}

const {
  action = '/api/membership.php',
  title = 'Mitglied werden',
  text = 'Werden Sie Mitglied im Schutzhaus am Hegerberg. Tragen Sie einfach Ihren Namen und Ihre E-Mail-Adresse ein – wir melden uns mit allen weiteren Informationen.',
} = Astro.props;

const fields = [
  {
    name: 'firstName',
    label: 'Vorname',
    type: 'text',
    autocomplete: 'given-name',
    placeholder: 'Maria',
    maxlength: 60,
  },
  {
    name: 'lastName',
    label: 'Nachname',
    type: 'text',
    autocomplete: 'family-name',
    placeholder: 'Musterfrau',
    maxlength: 60,
  },
  {
    name: 'email',
    label: 'E-Mail',
    type: 'email',
    autocomplete: 'email',
    placeholder: 'maria@beispiel.at',
    maxlength: 120,
  },
] as const;

const fieldClasses =
  'mt-2 w-full rounded-xl border border-wood-300 bg-wood-50 px-4 py-3 text-base text-wood-950 placeholder:text-wood-400 focus-visible:border-forest-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-600 aria-[invalid=true]:border-red-700';
const labelClasses =
  'block text-xs font-semibold uppercase tracking-[0.15em] text-wood-500';
---

<div id="mitglied-werden" class="card p-6 sm:p-8" data-membership>
  <h2 class="text-xl font-bold text-wood-950">{title}</h2>
  <p class="mt-3 text-sm leading-relaxed text-wood-700">{text}</p>

  <form
    class="mt-6 space-y-4"
    method="post"
    action={action}
    data-membership-form
  >
    {
      fields.map((field) => (
        <div>
          <label for={`membership-${field.name}`} class={labelClasses}>
            {field.label}
          </label>
          <input
            id={`membership-${field.name}`}
            name={field.name}
            type={field.type}
            required
            minlength={2}
            maxlength={field.maxlength}
            autocomplete={field.autocomplete}
            aria-describedby={`membership-${field.name}-error`}
            class={fieldClasses}
            placeholder={field.placeholder}
          />
          <p
            id={`membership-${field.name}-error`}
            class="mt-1 text-xs font-semibold text-red-700"
            data-membership-field-error={field.name}
            hidden
          />
        </div>
      ))
    }

    {/* Honeypot against spam bots – invisible to humans. */}
    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label for="membership-website">Webseite (bitte frei lassen)</label>
      <input
        id="membership-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <button type="submit" class="btn-primary w-full" data-membership-button>
      Anfrage senden
    </button>

    <p
      class="text-sm font-semibold"
      data-membership-message
      role="status"
      aria-live="polite"
      hidden
    >
    </p>
  </form>
</div>

<script>
  import { membershipSchema, MEMBERSHIP_FIELDS } from '../lib/membership';

  const MESSAGE_OK =
    'Danke! Ihre Anfrage ist bei uns eingegangen. Sie erhalten gleich eine Bestätigung per E-Mail.';
  const MESSAGE_ERROR =
    'Die Anfrage konnte nicht gesendet werden. Bitte rufen Sie uns an.';
  const MESSAGE_INVALID = 'Bitte prüfen Sie die markierten Felder.';

  for (const container of document.querySelectorAll<HTMLElement>(
    '[data-membership]',
  )) {
    const form = container.querySelector<HTMLFormElement>(
      '[data-membership-form]',
    );
    const button = container.querySelector<HTMLButtonElement>(
      '[data-membership-button]',
    );
    const message = container.querySelector<HTMLElement>(
      '[data-membership-message]',
    );
    if (!form || !message) continue;

    // From here on zod takes over validation – the native browser validation
    // stays in the markup only for the case without JavaScript.
    form.noValidate = true;

    const showMessage = (text: string, success: boolean) => {
      message.textContent = text;
      message.classList.toggle('text-forest-700', success);
      message.classList.toggle('text-red-700', !success);
      message.hidden = false;
    };

    const showFieldErrors = (errors: Record<string, string | undefined>) => {
      for (const field of MEMBERSHIP_FIELDS) {
        const display = form.querySelector<HTMLElement>(
          `[data-membership-field-error="${field}"]`,
        );
        const input = form.elements.namedItem(
          field,
        ) as HTMLInputElement | null;

        const text = errors[field];
        if (display) {
          display.textContent = text ?? '';
          display.hidden = !text;
        }
        input?.setAttribute('aria-invalid', text ? 'true' : 'false');
      }

      const firstId = MEMBERSHIP_FIELDS.find((field) => errors[field]);
      if (firstId) {
        (form.elements.namedItem(firstId) as HTMLInputElement | null)?.focus();
      }
    };

    // Show the outcome of the redirect taken without JavaScript.
    const outcome = new URLSearchParams(window.location.search).get('membership');
    if (outcome === 'ok') showMessage(MESSAGE_OK, true);
    if (outcome === 'error') showMessage(MESSAGE_ERROR, false);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      message.hidden = true;

      const formData = new FormData(form);
      const checked = membershipSchema.safeParse(
        Object.fromEntries(
          MEMBERSHIP_FIELDS.map((field) => [field, formData.get(field)]),
        ),
      );

      if (!checked.success) {
        const errors: Record<string, string> = {};
        for (const issue of checked.error.issues) {
          const field = String(issue.path[0] ?? '');
          errors[field] ??= issue.message;
        }
        showFieldErrors(errors);
        showMessage(MESSAGE_INVALID, false);
        return;
      }

      showFieldErrors({});

      if (button) {
        button.disabled = true;
        button.textContent = 'Wird gesendet …';
      }

      // Send the values normalised by zod (trimmed), plus the honeypot.
      const payload = new FormData();
      for (const [field, value] of Object.entries(checked.data)) {
        payload.set(field, value);
      }
      payload.set('website', String(formData.get('website') ?? ''));

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: payload,
        });
        const data = await response.json().catch(() => null);

        if (response.ok) {
          showMessage(data?.message ?? MESSAGE_OK, true);
          form.reset();
        } else {
          showMessage(data?.message ?? MESSAGE_ERROR, false);
        }
      } catch {
        showMessage(MESSAGE_ERROR, false);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'Anfrage senden';
        }
      }
    });
  }
</script>
