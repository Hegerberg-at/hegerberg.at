---
/**
 * Formular für eine Mitgliedschafts-Anfrage.
 *
 * Der Versand läuft serverseitig über /api/mitgliedschaft.php. Mit JavaScript
 * werden die Eingaben vorab mit zod geprüft (src/lib/mitgliedschaft.ts) und per
 * fetch() abgeschickt, ohne JavaScript greift der normale POST samt
 * Weiterleitung zurück auf diese Seite.
 */

interface Props {
  /** Serverseitiger Endpunkt, der die E-Mail versendet. */
  aktion?: string;
  titel?: string;
  text?: string;
}

const {
  aktion = '/api/mitgliedschaft.php',
  titel = 'Mitglied werden',
  text = 'Werden Sie Mitglied im Schutzhaus am Hegerberg. Tragen Sie einfach Ihren Namen und Ihre E-Mail-Adresse ein – wir melden uns mit allen weiteren Informationen.',
} = Astro.props;

const felder = [
  {
    name: 'vorname',
    label: 'Vorname',
    typ: 'text',
    autocomplete: 'given-name',
    platzhalter: 'Maria',
    maxlength: 60,
  },
  {
    name: 'nachname',
    label: 'Nachname',
    typ: 'text',
    autocomplete: 'family-name',
    platzhalter: 'Musterfrau',
    maxlength: 60,
  },
  {
    name: 'email',
    label: 'E-Mail',
    typ: 'email',
    autocomplete: 'email',
    platzhalter: 'maria@beispiel.at',
    maxlength: 120,
  },
] as const;

const feldKlassen =
  'mt-2 w-full rounded-xl border border-holz-300 bg-holz-50 px-4 py-3 text-base text-holz-950 placeholder:text-holz-400 focus-visible:border-wald-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wald-600 aria-[invalid=true]:border-red-700';
const labelKlassen =
  'block text-xs font-semibold uppercase tracking-[0.15em] text-holz-500';
---

<div id="mitglied-werden" class="card p-6 sm:p-8" data-mitgliedschaft>
  <h2 class="text-xl font-bold text-holz-950">{titel}</h2>
  <p class="mt-3 text-sm leading-relaxed text-holz-700">{text}</p>

  <form
    class="mt-6 space-y-4"
    method="post"
    action={aktion}
    data-mitgliedschaft-formular
  >
    {
      felder.map((feld) => (
        <div>
          <label for={`mitgliedschaft-${feld.name}`} class={labelKlassen}>
            {feld.label}
          </label>
          <input
            id={`mitgliedschaft-${feld.name}`}
            name={feld.name}
            type={feld.typ}
            required
            minlength={2}
            maxlength={feld.maxlength}
            autocomplete={feld.autocomplete}
            aria-describedby={`mitgliedschaft-${feld.name}-fehler`}
            class={feldKlassen}
            placeholder={feld.platzhalter}
          />
          <p
            id={`mitgliedschaft-${feld.name}-fehler`}
            class="mt-1 text-xs font-semibold text-red-700"
            data-mitgliedschaft-feldfehler={feld.name}
            hidden
          />
        </div>
      ))
    }

    {/* Honeypot gegen Spam-Bots – für Menschen unsichtbar. */}
    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label for="mitgliedschaft-webseite">Webseite (bitte frei lassen)</label>
      <input
        id="mitgliedschaft-webseite"
        name="webseite"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <button type="submit" class="btn-primary w-full" data-mitgliedschaft-knopf>
      Anfrage senden
    </button>

    <p
      class="text-sm font-semibold"
      data-mitgliedschaft-meldung
      role="status"
      aria-live="polite"
      hidden
    >
    </p>
  </form>
</div>

<script>
  import {
    mitgliedschaftSchema,
    MITGLIEDSCHAFT_FELDER,
  } from '../lib/mitgliedschaft';

  const MELDUNG_OK =
    'Danke! Ihre Anfrage ist bei uns eingegangen. Sie erhalten gleich eine Bestätigung per E-Mail.';
  const MELDUNG_FEHLER =
    'Die Anfrage konnte nicht gesendet werden. Bitte rufen Sie uns an.';
  const MELDUNG_UNGUELTIG = 'Bitte prüfen Sie die markierten Felder.';

  for (const behaelter of document.querySelectorAll<HTMLElement>(
    '[data-mitgliedschaft]',
  )) {
    const formular = behaelter.querySelector<HTMLFormElement>(
      '[data-mitgliedschaft-formular]',
    );
    const knopf = behaelter.querySelector<HTMLButtonElement>(
      '[data-mitgliedschaft-knopf]',
    );
    const meldung = behaelter.querySelector<HTMLElement>(
      '[data-mitgliedschaft-meldung]',
    );
    if (!formular || !meldung) continue;

    // Ab hier übernimmt zod die Prüfung – die native Browser-Validierung
    // bleibt nur für den Fall ohne JavaScript im Markup stehen.
    formular.noValidate = true;

    const zeigeMeldung = (text: string, erfolg: boolean) => {
      meldung.textContent = text;
      meldung.classList.toggle('text-wald-700', erfolg);
      meldung.classList.toggle('text-red-700', !erfolg);
      meldung.hidden = false;
    };

    const zeigeFeldfehler = (fehler: Record<string, string | undefined>) => {
      for (const feld of MITGLIEDSCHAFT_FELDER) {
        const anzeige = formular.querySelector<HTMLElement>(
          `[data-mitgliedschaft-feldfehler="${feld}"]`,
        );
        const eingabe = formular.elements.namedItem(
          feld,
        ) as HTMLInputElement | null;

        const text = fehler[feld];
        if (anzeige) {
          anzeige.textContent = text ?? '';
          anzeige.hidden = !text;
        }
        eingabe?.setAttribute('aria-invalid', text ? 'true' : 'false');
      }

      const ersteId = MITGLIEDSCHAFT_FELDER.find((feld) => fehler[feld]);
      if (ersteId) {
        (
          formular.elements.namedItem(ersteId) as HTMLInputElement | null
        )?.focus();
      }
    };

    // Ergebnis der Weiterleitung ohne JavaScript anzeigen.
    const ergebnis = new URLSearchParams(window.location.search).get(
      'mitgliedschaft',
    );
    if (ergebnis === 'ok') zeigeMeldung(MELDUNG_OK, true);
    if (ergebnis === 'fehler') zeigeMeldung(MELDUNG_FEHLER, false);

    formular.addEventListener('submit', async (ereignis) => {
      ereignis.preventDefault();
      meldung.hidden = true;

      const formularDaten = new FormData(formular);
      const geprueft = mitgliedschaftSchema.safeParse(
        Object.fromEntries(
          MITGLIEDSCHAFT_FELDER.map((feld) => [feld, formularDaten.get(feld)]),
        ),
      );

      if (!geprueft.success) {
        const fehler: Record<string, string> = {};
        for (const problem of geprueft.error.issues) {
          const feld = String(problem.path[0] ?? '');
          fehler[feld] ??= problem.message;
        }
        zeigeFeldfehler(fehler);
        zeigeMeldung(MELDUNG_UNGUELTIG, false);
        return;
      }

      zeigeFeldfehler({});

      if (knopf) {
        knopf.disabled = true;
        knopf.textContent = 'Wird gesendet …';
      }

      // Die von zod normalisierten Werte senden (getrimmt), plus Honeypot.
      const nutzlast = new FormData();
      for (const [feld, wert] of Object.entries(geprueft.data)) {
        nutzlast.set(feld, wert);
      }
      nutzlast.set('webseite', String(formularDaten.get('webseite') ?? ''));

      try {
        const antwort = await fetch(formular.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: nutzlast,
        });
        const daten = await antwort.json().catch(() => null);

        if (antwort.ok) {
          zeigeMeldung(daten?.meldung ?? MELDUNG_OK, true);
          formular.reset();
        } else {
          zeigeMeldung(daten?.meldung ?? MELDUNG_FEHLER, false);
        }
      } catch {
        zeigeMeldung(MELDUNG_FEHLER, false);
      } finally {
        if (knopf) {
          knopf.disabled = false;
          knopf.textContent = 'Anfrage senden';
        }
      }
    });
  }
</script>
