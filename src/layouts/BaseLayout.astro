---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, addressOneLine } from '../lib/site';
import { getOpeningHours, schemaOpeningHours } from '../lib/opening-hours';

interface Props {
  title?: string;
  description?: string;
  /**
   * Preview image for social networks, relative to the site root. Without it
   * the site-wide default applies. Its dimensions are only announced for that
   * default, so a page passing its own image stays silent about them.
   */
  image?: string;
  /** Enables the transparent header mode (home page with hero only). */
  transparentHeader?: boolean;
}

const {
  title,
  description = site.description,
  image,
  transparentHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} – ${site.name}` : `${site.name}`;
const baseUrl = Astro.site ?? site.domain;
const canonical = new URL(Astro.url.pathname, baseUrl).href;

/** Open Graph needs an absolute URL, a relative path is ignored by the crawlers. */
const previewImage = new URL(image ?? site.ogImage.path, baseUrl).href;
const previewSize = image
  ? {}
  : { type: site.ogImage.type, width: site.ogImage.width, height: site.ogImage.height };

const days = await getOpeningHours();

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: site.address.street,
  postalCode: site.address.postalCode,
  addressLocality: site.address.city,
  addressRegion: site.address.state,
  addressCountry: 'AT',
};

/**
 * The Schutzhaus is run by a non-profit organisation, so the markup describes
 * an Organization rather than a business.
 *
 * Organization has no `geo` and no `openingHours` of its own – those belong to
 * a place. They therefore sit on the Place under `location`, which is also
 * what carries the coordinates for map and search results.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.domain,
  telephone: site.phone,
  email: site.email,
  address: postalAddress,
  location: {
    '@type': 'Place',
    name: site.name,
    address: postalAddress,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: site.geo.lat,
      longitude: site.geo.lng,
      elevation: site.geo.elevation,
    },
    openingHoursSpecification: schemaOpeningHours(days),
  },
};
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Title, description, canonical, robots and the Open Graph tags. The
        remaining tags below are not SEO and stay plain markup. */}
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: pageTitle,
          type: 'website',
          image: previewImage,
          url: canonical,
        },
        optional: {
          siteName: site.name,
          description,
          locale: 'de_AT',
        },
        image: { alt: site.claim, ...previewSize },
      }}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    {/* For installing on the home screen – on iOS this is the prerequisite
        for push notifications being possible at all. */}
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#2e4f34" />

    <meta name="geo.region" content="AT-3" />
    <meta name="geo.placename" content={addressOneLine} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-forest-700 focus:px-4 focus:py-2 focus:text-wood-50"
    >
      Zum Inhalt springen
    </a>
    <Header transparent={transparentHeader} />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
