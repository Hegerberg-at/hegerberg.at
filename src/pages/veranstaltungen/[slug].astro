---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { formatDate, formatDateShort, isoDate } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

/**
 * The detail page shows the body text („Weitere Details“). If it is empty, the
 * short description takes its place – that one may contain markdown as well
 * (e.g. lists) and is then rendered accordingly.
 */
const hasBodyText = Boolean(event.body?.trim());
const descriptionHtml = hasBodyText
  ? ''
  : await renderMarkdown(data.description);

const dateText = data.endDate
  ? `${formatDateShort(data.date)} – ${formatDateShort(data.endDate)}`
  : formatDate(data.date);

const today = new Date();
today.setHours(0, 0, 0, 0);
const isPast = (data.endDate ?? data.date) < today;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="container-page py-12 sm:py-16">
    <a
      href="/veranstaltungen/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-forest-700 transition hover:text-forest-900"
    >
      <span aria-hidden="true">←</span> Alle Veranstaltungen
    </a>

    <header class="mt-6">
      <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-forest-700">
        <time datetime={isoDate(data.date)}>{dateText}</time>
        {data.time && <span class="text-wood-600">· {data.time} Uhr</span>}
      </p>

      <h1 class="mt-3 text-3xl font-bold text-wood-950 sm:text-4xl">
        {data.title}
      </h1>

      {
        data.cancelled && (
          <p class="mt-4 inline-block rounded-full bg-red-100 px-4 py-2 text-sm font-semibold text-red-800">
            Diese Veranstaltung wurde abgesagt.
          </p>
        )
      }

      {
        !data.cancelled && isPast && (
          <p class="mt-4 inline-block rounded-full bg-wood-100 px-4 py-2 text-sm font-semibold text-wood-700">
            Diese Veranstaltung liegt bereits zurück.
          </p>
        )
      }
    </header>

    <!--
      From lg on two columns: text left, image right.
      Below that everything stays stacked (one column).
    -->
    <div
      class:list={[
        'mt-10 flex flex-col-reverse gap-10',
        data.image && 'lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start lg:gap-12',
      ]}
    >
      <div class="prose-hegerberg leading-relaxed text-wood-800">
        {hasBodyText ? <Content /> : <Fragment set:html={descriptionHtml} />}
      </div>

      {
        data.image && (
          <figure class="sm:max-w-lg lg:max-w-full lg:sticky lg:top-28">
            <img
              src={data.image}
              alt={data.imageAlt ?? ''}
              loading="eager"
              decoding="async"
              class="w-full rounded-2xl object-cover shadow-lg"
            />
            {data.imageAlt && (
              <figcaption class="mt-3 text-sm text-wood-600">
                {data.imageAlt}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>

    {
      data.gallery.length > 0 && (
        <div class="mt-14">
          <ImageGallery images={data.gallery} title="Bilder zur Veranstaltung" />
        </div>
      )
    }

    <aside class="card mt-14 flex flex-wrap items-center justify-between gap-4 p-6">
      <div>
        <p class="font-display text-lg font-bold text-wood-950">
          Fragen oder Tisch reservieren?
        </p>
        <p class="mt-1 text-sm text-wood-700">
          Wir freuen uns über Ihren Anruf – {site.phoneDisplay}
        </p>
      </div>
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn-primary">
        Anrufen
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  .prose-hegerberg :global(p) {
    margin-block: 1rem;
  }
  .prose-hegerberg :global(p:first-child) {
    margin-block-start: 0;
    font-size: 1.125rem;
  }
  .prose-hegerberg :global(h2),
  .prose-hegerberg :global(h3) {
    margin-block: 1.75rem 0.5rem;
    font-weight: 700;
  }
  .prose-hegerberg :global(h2) {
    font-size: 1.5rem;
  }
  .prose-hegerberg :global(h3) {
    font-size: 1.25rem;
  }
  .prose-hegerberg :global(ul) {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }
  .prose-hegerberg :global(ol) {
    list-style: decimal;
    padding-inline-start: 1.25rem;
  }
  .prose-hegerberg :global(li) {
    margin-block: 0.4rem;
  }
  .prose-hegerberg :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-hegerberg :global(img) {
    border-radius: 1rem;
    margin-block: 1.5rem;
  }
  .prose-hegerberg :global(blockquote) {
    border-inline-start: 3px solid var(--color-forest-300);
    padding-inline-start: 1rem;
    font-style: italic;
  }
</style>
