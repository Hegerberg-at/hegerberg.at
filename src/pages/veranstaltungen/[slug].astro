---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bildergalerie from '../../components/Bildergalerie.astro';
import { formatDatum, formatDatumKurz, isoDatum } from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { site } from '../../lib/site';

export const getStaticPaths = (async () => {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}) satisfies GetStaticPaths;

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);

/**
 * Auf der Detailseite steht der Fließtext („Weitere Details“). Ist er leer,
 * tritt die Kurzbeschreibung an seine Stelle – die darf ebenfalls Markdown
 * enthalten (z. B. Aufzählungen) und wird dann geparst ausgegeben.
 */
const hatFliesstext = Boolean(event.body?.trim());
const beschreibungHtml = hatFliesstext
  ? ''
  : await renderMarkdown(data.beschreibung);

const datumsText = data.datumBis
  ? `${formatDatumKurz(data.datum)} – ${formatDatumKurz(data.datumBis)}`
  : formatDatum(data.datum);

const heute = new Date();
heute.setHours(0, 0, 0, 0);
const vorbei = (data.datumBis ?? data.datum) < heute;
---

<BaseLayout title={data.titel} description={data.beschreibung}>
  <article class="container-page py-12 sm:py-16">
    <a
      href="/veranstaltungen/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-wald-700 transition hover:text-wald-900"
    >
      <span aria-hidden="true">←</span> Alle Veranstaltungen
    </a>

    <header class="mt-6">
      <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-wald-700">
        <time datetime={isoDatum(data.datum)}>{datumsText}</time>
        {data.uhrzeit && <span class="text-holz-600">· {data.uhrzeit} Uhr</span>}
      </p>

      <h1 class="mt-3 text-3xl font-bold text-holz-950 sm:text-4xl">
        {data.titel}
      </h1>

      {
        data.abgesagt && (
          <p class="mt-4 inline-block rounded-full bg-red-100 px-4 py-2 text-sm font-semibold text-red-800">
            Diese Veranstaltung wurde abgesagt.
          </p>
        )
      }

      {
        !data.abgesagt && vorbei && (
          <p class="mt-4 inline-block rounded-full bg-holz-100 px-4 py-2 text-sm font-semibold text-holz-700">
            Diese Veranstaltung liegt bereits zurück.
          </p>
        )
      }
    </header>

    <!--
      Ab lg zweispaltig: Text links, Bild rechts.
      Darunter bleibt alles untereinander (eine Spalte).
    -->
    <div
      class:list={[
        'mt-10 flex flex-col-reverse gap-10',
        data.bild && 'lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start lg:gap-12',
      ]}
    >
      <div class="prose-hegerberg leading-relaxed text-holz-800">
        {hatFliesstext ? <Content /> : <Fragment set:html={beschreibungHtml} />}
      </div>

      {
        data.bild && (
          <figure class="sm:max-w-lg lg:max-w-full lg:sticky lg:top-28">
            <img
              src={data.bild}
              alt={data.bildAlt ?? ''}
              loading="eager"
              decoding="async"
              class="w-full rounded-2xl object-cover shadow-lg"
            />
            {data.bildAlt && (
              <figcaption class="mt-3 text-sm text-holz-600">
                {data.bildAlt}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>

    {
      data.galerie.length > 0 && (
        <div class="mt-14">
          <Bildergalerie bilder={data.galerie} titel="Bilder zur Veranstaltung" />
        </div>
      )
    }

    <aside class="card mt-14 flex flex-wrap items-center justify-between gap-4 p-6">
      <div>
        <p class="font-display text-lg font-bold text-holz-950">
          Fragen oder Tisch reservieren?
        </p>
        <p class="mt-1 text-sm text-holz-700">
          Wir freuen uns über Ihren Anruf – {site.telefonAnzeige}
        </p>
      </div>
      <a href={`tel:${site.telefon.replace(/\s/g, '')}`} class="btn-primary">
        Anrufen
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  .prose-hegerberg :global(p) {
    margin-block: 1rem;
  }
  .prose-hegerberg :global(p:first-child) {
    margin-block-start: 0;
    font-size: 1.125rem;
  }
  .prose-hegerberg :global(h2),
  .prose-hegerberg :global(h3) {
    margin-block: 1.75rem 0.5rem;
    font-weight: 700;
  }
  .prose-hegerberg :global(h2) {
    font-size: 1.5rem;
  }
  .prose-hegerberg :global(h3) {
    font-size: 1.25rem;
  }
  .prose-hegerberg :global(ul) {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }
  .prose-hegerberg :global(ol) {
    list-style: decimal;
    padding-inline-start: 1.25rem;
  }
  .prose-hegerberg :global(li) {
    margin-block: 0.4rem;
  }
  .prose-hegerberg :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-hegerberg :global(img) {
    border-radius: 1rem;
    margin-block: 1.5rem;
  }
  .prose-hegerberg :global(blockquote) {
    border-inline-start: 3px solid var(--color-wald-300);
    padding-inline-start: 1rem;
    font-style: italic;
  }
</style>
