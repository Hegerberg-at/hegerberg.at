---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import PushSignup from '../../components/PushSignup.astro';
import { eventUntil } from '../../lib/events';
import { isoDate } from '../../lib/format';

/** How many past events the list shows at most. */
const PAST_LIMIT = 6;

const today = isoDate(new Date());

const byDateAsc = (await getCollection('events')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);

const upcoming = byDateAsc.filter((event) => eventUntil(event) >= today);

// The static build freezes the date it was generated on, so the browser decides
// which entry is upcoming and which one has passed (see lib/event-split.ts).
// The past list therefore also has to carry the events that are still upcoming
// at build time but will have passed by the time a visitor loads the page.
const past = [...byDateAsc].reverse().slice(0, upcoming.length + PAST_LIMIT);
const pastAtBuild = past.filter((event) => eventUntil(event) < today);
---

<BaseLayout
  title="Veranstaltungen"
  description="Feste, Live-Musik und geführte Wanderungen am Hegerberg – alle kommenden Veranstaltungen des Schutzhauses im Überblick."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Termine"
      title="Veranstaltungen am Hegerberg"
    />

    {
      upcoming.length > 0 && (
        <div
          data-events-upcoming
          data-entry-display="contents"
          class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
        >
          {upcoming.map((event) => (
            <div data-until={eventUntil(event)} class="contents">
              <EventCard
                title={event.data.title}
                date={event.data.date}
                endDate={event.data.endDate}
                time={event.data.time}
                description={event.data.description}
                image={event.data.image}
                imageAlt={event.data.imageAlt}
                cancelled={event.data.cancelled}
                href={`/veranstaltungen/${event.id}/`}
              />
            </div>
          ))}
        </div>
      )
    }

    <p
      data-events-empty
      hidden={upcoming.length > 0}
      class="mt-12 rounded-2xl border border-wood-200 bg-wood-100 p-8 text-wood-700"
    >
      Derzeit sind keine Veranstaltungen angekündigt. Schauen Sie bald wieder
      vorbei.
    </p>

    <div class="mt-12">
      <PushSignup />
    </div>

    {
      past.length > 0 && (
        <section
          data-events-section
          hidden={pastAtBuild.length === 0}
          class="mt-20"
        >
          <h2 class="text-2xl font-bold text-wood-950">Bereits gewesen</h2>
          <ul
            data-events-past
            data-limit={PAST_LIMIT}
            class="mt-6 divide-y divide-wood-200 border-y border-wood-200"
          >
            {past.map((event) => (
              <li
                data-until={eventUntil(event)}
                hidden={
                  eventUntil(event) >= today ||
                  pastAtBuild.indexOf(event) >= PAST_LIMIT
                }
              >
                <a
                  href={`/veranstaltungen/${event.id}/`}
                  class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 transition hover:text-forest-800"
                >
                  <span class="font-semibold text-wood-800">
                    {event.data.title}
                  </span>
                  <time
                    datetime={isoDate(event.data.date)}
                    class="text-sm tabular-nums text-wood-600"
                  >
                    {event.data.date.toLocaleDateString('de-AT', {
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric',
                      timeZone: 'Europe/Vienna',
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import { watchEventSplit } from '../../lib/event-split';

  watchEventSplit();
</script>
