---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventCard from '../../components/EventCard.astro';
import PushSignup from '../../components/PushSignup.astro';

const today = new Date();
today.setHours(0, 0, 0, 0);

const all = await getCollection('events');

const upcoming = all
  .filter((event) => (event.data.endDate ?? event.data.date) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = all
  .filter((event) => (event.data.endDate ?? event.data.date) < today)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<BaseLayout
  title="Veranstaltungen"
  description="Feste, Live-Musik und geführte Wanderungen am Hegerberg – alle kommenden Veranstaltungen des Schutzhauses im Überblick."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Termine"
      title="Veranstaltungen am Hegerberg"
    />

    {
      upcoming.length > 0 ? (
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              endDate={event.data.endDate}
              time={event.data.time}
              description={event.data.description}
              image={event.data.image}
              imageAlt={event.data.imageAlt}
              cancelled={event.data.cancelled}
              href={`/veranstaltungen/${event.id}/`}
            />
          ))}
        </div>
      ) : (
        <p class="mt-12 rounded-2xl border border-wood-200 bg-wood-100 p-8 text-wood-700">
          Derzeit sind keine Veranstaltungen angekündigt. Schauen Sie bald
          wieder vorbei.
        </p>
      )
    }

    <div class="mt-12">
      <PushSignup />
    </div>

    {
      past.length > 0 && (
        <section class="mt-20">
          <h2 class="text-2xl font-bold text-wood-950">Bereits gewesen</h2>
          <ul class="mt-6 divide-y divide-wood-200 border-y border-wood-200">
            {past.map((event) => (
              <li>
                <a
                  href={`/veranstaltungen/${event.id}/`}
                  class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 transition hover:text-forest-800"
                >
                  <span class="font-semibold text-wood-800">
                    {event.data.title}
                  </span>
                  <time
                    datetime={event.data.date.toISOString().slice(0, 10)}
                    class="text-sm tabular-nums text-wood-600"
                  >
                    {event.data.date.toLocaleDateString('de-AT', {
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric',
                      timeZone: 'Europe/Vienna',
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
