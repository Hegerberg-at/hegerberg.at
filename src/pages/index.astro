---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import OpeningHoursWidget from '../components/OpeningHoursWidget.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';

import TourCard from '../components/TourCard.astro';
import { loadTours } from '../lib/tours';

import BecomeMembership from '../components/BecomeMembership.astro';
import { site } from '../lib/site';
import { formatPrice } from '../lib/format';

/** Editorial texts of the home page (Decap collection „Startseite“). */
const home = await getEntry('home', 'index');
if (!home) {
  throw new Error('src/content/home/index.md fehlt.');
}
const { hero, welcome, specialties: kitchen, cta } = home.data;
const eventsText = home.data.events;

const today = new Date();
today.setHours(0, 0, 0, 0);

const events = (await getCollection('events'))
  .filter((event) => (event.data.endDate ?? event.data.date) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const tours = await loadTours();

const specialties = (await getCollection('menu'))
  .filter((dish) => dish.data.houseSpecialty && dish.data.available)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const history = (await getCollection('history')).sort(
  (a, b) => a.data.order - b.data.order,
)[0];
---

<BaseLayout transparentHeader>
  <Hero image={hero.image} title={hero.title} subtitle={hero.subtitle} />

  <!-- Öffnungszeiten prominent direkt unter dem Hero -->
  <section class="container-page -mt-16 sm:-mt-20">
    <div class="grid gap-8 lg:grid-cols-[1fr_minmax(0,26rem)]">
      <div class="order-2 flex flex-col justify-center lg:order-1 lg:pt-20">
        <SectionHeading
          eyebrow={welcome.eyebrow}
          title={welcome.title}
          text={welcome.text}
        />
        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-wood-600">
              Seehöhe
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-forest-800">
              {site.geo.elevation}&nbsp;m
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-wood-600">
              Anfahrt
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-forest-800">
              {site.address.city}
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-wood-600">
              Reservierung
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-forest-800">
              <a
                href={`tel:${site.phone.replace(/\s/g, '')}`}
                class="hover:underline">{site.phoneDisplay}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="order-1 lg:order-2">
        <OpeningHoursWidget variant="compact" class="relative z-10" />
      </div>
    </div>
  </section>

  <!-- Hausspezialitäten -->
  <!-- Derzeit deaktiviert -->
  <!-- {
    specialties.length > 0 && (
      <section class="container-page mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading
            eyebrow={kitchen.eyebrow}
            title={kitchen.title}
            text={kitchen.text}
          />
          <a href="/speisekarte/" class="btn-outline">
            Ganze Speisekarte
          </a>
        </div>

        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {specialties.map((dish) => (
            <li class="card flex flex-col p-6">
              <h3 class="font-display text-xl font-bold text-wood-950">
                {dish.data.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-wood-700">
                {dish.data.description}
              </p>
              <p class="mt-5 font-display text-lg font-bold text-forest-800">
                {formatPrice(dish.data.price)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  } -->

  <!-- Geschichte-Teaser -->
  {
    history && (
      <section class="mt-24 bg-forest-900 py-20 text-wood-100">
        <div class="container-page grid items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="eyebrow text-forest-300">Seit {history.data.year}</p>
            <h2 class="mt-2 text-3xl font-bold text-wood-50 sm:text-4xl">
              {history.data.title}
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-wood-200">
              {history.data.description}
            </p>
            <a href="/geschichte/" class="btn-secondary mt-8">
              Die ganze Geschichte
            </a>
          </div>
          <div
            class="aspect-[4/3] rounded-2xl bg-[url('/images/hero.svg')] bg-cover bg-center shadow-2xl"
            role="img"
            aria-label="Panorama über den Wienerwald"
          />
        </div>
      </section>
    )
  }

  <!-- Events -->
  {
    events.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          eyebrow={eventsText.eyebrow}
          title={eventsText.title}
          text={eventsText.text}
          centered
        />
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              endDate={event.data.endDate}
              time={event.data.time}
              description={event.data.description}
              image={event.data.image}
              imageAlt={event.data.imageAlt}
              cancelled={event.data.cancelled}
              href={`/veranstaltungen/${event.id}/`}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/veranstaltungen/" class="btn-outline">
            Alle Veranstaltungen
          </a>
        </div>
      </section>
    )
  }

<!-- Aktivitäten -->
  {
    events.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          eyebrow="Unterwegs"
          title="Aktivitäten rund um den Hegerberg"
          text="Von Forststraßen fürs Rad über ruhige Waldwege zum Wandern. Alle Touren gibt es als GPX-Datei zum Mitnehmen aufs Navi oder Handy."
          centered
        />
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {tours.map((tour) => (
              <div data-type={tour.entry.data.type} class="contents">
                <TourCard
                  href={tour.href}
                  title={tour.entry.data.title}
                  type={tour.entry.data.type}
                  difficulty={tour.entry.data.difficulty}
                  description={tour.entry.data.description}
                  image={tour.entry.data.image}
                  imageAlt={tour.entry.data.imageAlt}
                  data={tour.data}
                  durationMinutes={tour.durationMinutes}
                />
              </div>
            ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/aktivitaeten/" class="btn-outline">
            Alle Aktivitäten
          </a>
        </div>
      </section>
    )
  }


  <!-- Mitgliedschaft -->
  <section class="container-page mt-24">
    <div class="max-w-3xl flex mx-auto">
      <BecomeMembership />
    </div>
  </section>
</BaseLayout>
