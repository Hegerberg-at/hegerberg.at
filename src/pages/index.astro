---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import OeffnungszeitenWidget from '../components/OeffnungszeitenWidget.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import { site, adresseEinzeilig } from '../lib/site';
import { formatPreis } from '../lib/format';

/** Redaktionelle Texte der Startseite (Decap-Collection „startseite“). */
const startseite = await getEntry('startseite', 'index');
if (!startseite) {
  throw new Error('src/content/startseite/index.md fehlt.');
}
const { hero, willkommen, spezialitaeten: kueche, cta } = startseite.data;
const veranstaltungenText = startseite.data.veranstaltungen;

const heute = new Date();
heute.setHours(0, 0, 0, 0);

const events = (await getCollection('events'))
  .filter((event) => (event.data.datumBis ?? event.data.datum) >= heute)
  .sort((a, b) => a.data.datum.getTime() - b.data.datum.getTime())
  .slice(0, 3);

const spezialitaeten = (await getCollection('speisekarte'))
  .filter((speise) => speise.data.hausspezialitaet && speise.data.verfuegbar)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
  .slice(0, 3);

const geschichte = (await getCollection('geschichte')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
)[0];
---

<BaseLayout transparentHeader>
  <Hero bild={hero.bild} titel={hero.titel} untertitel={hero.untertitel} />

  <!-- Öffnungszeiten prominent direkt unter dem Hero -->
  <section class="container-page -mt-16 sm:-mt-20">
    <div class="grid gap-8 lg:grid-cols-[1fr_minmax(0,26rem)]">
      <div class="order-2 flex flex-col justify-center lg:order-1 lg:pt-20">
        <SectionHeading
          eyebrow={willkommen.eyebrow}
          titel={willkommen.titel}
          text={willkommen.text}
        />
        <dl class="mt-8 grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-holz-600">
              Seehöhe
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-wald-800">
              {site.geo.seehoehe}&nbsp;m
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-holz-600">
              Anfahrt
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-wald-800">
              {site.adresse.ort}
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-holz-600">
              Reservierung
            </dt>
            <dd class="mt-1 font-display text-2xl font-bold text-wald-800">
              <a
                href={`tel:${site.telefon.replace(/\s/g, '')}`}
                class="hover:underline">{site.telefonAnzeige}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="order-1 lg:order-2">
        <OeffnungszeitenWidget variante="kompakt" class="z-10" />
      </div>
    </div>
  </section>

  <!-- Hausspezialitäten -->
  <!-- Derzeit deaktiviert -->
  <!-- {
    spezialitaeten.length > 0 && (
      <section class="container-page mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading
            eyebrow={kueche.eyebrow}
            titel={kueche.titel}
            text={kueche.text}
          />
          <a href="/speisekarte/" class="btn-outline">
            Ganze Speisekarte
          </a>
        </div>

        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {spezialitaeten.map((speise) => (
            <li class="card flex flex-col p-6">
              <h3 class="font-display text-xl font-bold text-holz-950">
                {speise.data.name}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-holz-700">
                {speise.data.beschreibung}
              </p>
              <p class="mt-5 font-display text-lg font-bold text-wald-800">
                {formatPreis(speise.data.preis)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  } -->

  <!-- Geschichte-Teaser -->
  {
    geschichte && (
      <section class="mt-24 bg-wald-900 py-20 text-holz-100">
        <div class="container-page grid items-center gap-12 lg:grid-cols-2">
          <div>
            <p class="eyebrow text-wald-300">Seit {geschichte.data.jahr}</p>
            <h2 class="mt-2 text-3xl font-bold text-holz-50 sm:text-4xl">
              {geschichte.data.titel}
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-holz-200">
              {geschichte.data.beschreibung}
            </p>
            <a href="/geschichte/" class="btn-secondary mt-8">
              Die ganze Geschichte
            </a>
          </div>
          <div
            class="aspect-[4/3] rounded-2xl bg-[url('/images/hero.svg')] bg-cover bg-center shadow-2xl"
            role="img"
            aria-label="Panorama über den Wienerwald"
          />
        </div>
      </section>
    )
  }

  <!-- Events -->
  {
    events.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          eyebrow={veranstaltungenText.eyebrow}
          titel={veranstaltungenText.titel}
          text={veranstaltungenText.text}
          zentriert
        />
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {events.map((event) => (
            <EventCard
              titel={event.data.titel}
              datum={event.data.datum}
              datumBis={event.data.datumBis}
              uhrzeit={event.data.uhrzeit}
              beschreibung={event.data.beschreibung}
              bild={event.data.bild}
              bildAlt={event.data.bildAlt}
              abgesagt={event.data.abgesagt}
              href={`/veranstaltungen/${event.id}/`}
            />
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/veranstaltungen/" class="btn-outline">
            Alle Veranstaltungen
          </a>
        </div>
      </section>
    )
  }

  <!-- Anfahrt-CTA -->
  <section class="container-page mt-24">
    <div
      class="card flex flex-col items-start gap-6 bg-holz-100 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-12"
    >
      <div>
        <h2 class="text-2xl font-bold text-holz-950 sm:text-3xl">
          {cta.titel}
        </h2>
        <p class="mt-3 text-holz-700">
          {adresseEinzeilig} · Reservierungen unter {site.telefonAnzeige}
        </p>
      </div>
      <a href="/kontakt/" class="btn-primary shrink-0">Anfahrt &amp; Kontakt</a>
    </div>
  </section>
</BaseLayout>
