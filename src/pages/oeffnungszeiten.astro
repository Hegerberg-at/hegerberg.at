    <SectionHeading
      as="h1"
      eyebrow="Wann wir da sind"
      titel="Öffnungszeiten"
      text="Wir haben Mittwoch bis Sonntag geöffnet. Montag und Dienstag sind unsere Ruhetage."
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,28rem)_1fr]">
      <OeffnungszeitenWidget variante="voll" class="self-start" />

