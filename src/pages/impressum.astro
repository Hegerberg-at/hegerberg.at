---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Impressum"
  description="Impressum und Offenlegung gemäß § 5 ECG und § 25 MedienG für hegerberg.at."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Rechtliches"
      titel="Impressum"
      text="Offenlegung gemäß § 5 E-Commerce-Gesetz und § 25 Mediengesetz."
    />

    <div class="mt-12 max-w-2xl space-y-8 leading-relaxed text-holz-800">
      <section>
        <h2 class="text-xl font-bold text-holz-950">Medieninhaber &amp; Betreiber</h2>
        <address class="mt-3 not-italic">
          {site.impressum.inhaber}<br />
          {site.adresse.strasse}<br />
          {site.adresse.plz}&nbsp;{site.adresse.ort}<br />
          {site.adresse.land}
        </address>
        <p class="mt-3">
          Telefon: <a
            href={`tel:${site.telefon.replace(/\s/g, '')}`}
            class="underline underline-offset-4">{site.telefonAnzeige}</a
          ><br />
          E-Mail: <a
            href={`mailto:${site.email}`}
            class="underline underline-offset-4">{site.email}</a
          >
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-holz-950">Unternehmensgegenstand</h2>
        <p class="mt-3">{site.impressum.unternehmensgegenstand}</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-holz-950">
          Gewerbebehörde &amp; Kammerzugehörigkeit
        </h2>
        <p class="mt-3">
          Gewerbebehörde: {site.impressum.behoerde}<br />
          Kammer: {site.impressum.kammer}<br />
          Anwendbare Rechtsvorschrift: Gewerbeordnung (
          <a
            href="https://www.ris.bka.gv.at"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4">ris.bka.gv.at</a
          >)
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-holz-950">Online-Streitbeilegung</h2>
        <p class="mt-3">
          Die Europäische Kommission stellt eine Plattform zur
          Online-Streitbeilegung bereit:
          <a
            href="https://ec.europa.eu/consumers/odr"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4">ec.europa.eu/consumers/odr</a
          >. Wir sind nicht verpflichtet und nicht bereit, an einem
          Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle
          teilzunehmen.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-holz-950">Haftung für Inhalte</h2>
        <p class="mt-3">
          Die Inhalte dieser Website werden mit größtmöglicher Sorgfalt erstellt.
          Für die Richtigkeit, Vollständigkeit und Aktualität – insbesondere von
          Preisen und Öffnungszeiten – kann jedoch keine Gewähr übernommen
          werden. Für Inhalte externer Links ist ausschließlich deren Betreiber
          verantwortlich.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-holz-950">Urheberrecht</h2>
        <p class="mt-3">
          Texte und Bilder dieser Website sind urheberrechtlich geschützt. Eine
          Verwendung außerhalb der Grenzen des Urheberrechts bedarf der
          schriftlichen Zustimmung des Medieninhabers.
        </p>
      </section>

      <p
        class="rounded-xl border border-holz-300 bg-holz-100 p-4 text-sm text-holz-700"
      >
        <strong>Hinweis für die Redaktion:</strong> Die hier ausgewiesenen Daten
        stammen aus <code>src/lib/site.ts</code> und sind teilweise Platzhalter.
        Bitte vor dem Livegang durch die tatsächlichen Firmendaten ersetzen und
        rechtlich prüfen lassen.
      </p>
    </div>
  </div>
</BaseLayout>
