---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MenuItem from '../components/MenuItem.astro';
import AllergenLegend from '../components/AllergenLegend.astro';

const CATEGORIES = [
  'Suppen',
  'Vorspeisen',
  'Hauptspeisen',
  'Desserts',
  'Getränke',
] as const;

const all = await getCollection('menu');

const grouped = CATEGORIES.map((category) => ({
  category,
  dishes: all
    .filter((dish) => dish.data.category === category)
    .sort(
      (a, b) =>
        a.data.order - b.data.order ||
        a.data.name.localeCompare(b.data.name, 'de-AT'),
    ),
})).filter((group) => group.dishes.length > 0);

const usedAllergens = [
  ...new Set(all.flatMap((dish) => dish.data.allergens)),
];

const anchor = (category: string) =>
  category.toLowerCase().replace(/ä/g, 'ae').replace(/[^a-z]/g, '-');
---

<BaseLayout
  title="Speisekarte"
  description="Die Speisekarte des Schutzhauses am Hegerberg: Suppen, Vorspeisen, österreichische Hauptspeisen, Mehlspeisen und Getränke – mit Allergenkennzeichnung."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Speisen & Getränke"
      title="Unsere Speisekarte"
      text="Bodenständige österreichische Küche mit Produkten aus der Region. Alle Preise in Euro inklusive Steuern und Abgaben."
    />

    <nav aria-label="Kategorien" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          grouped.map((group) => (
            <li>
              <a
                href={`#${anchor(group.category)}`}
                class="inline-block rounded-full border border-wood-300 px-4 py-2 text-sm font-semibold text-wood-800 transition hover:border-forest-600 hover:bg-forest-50 hover:text-forest-800"
              >
                {group.category}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-14 space-y-14">
      {
        grouped.map((group) => (
          <section
            id={anchor(group.category)}
            class="scroll-mt-28"
            aria-labelledby={`title-${anchor(group.category)}`}
          >
            <h2
              id={`title-${anchor(group.category)}`}
              class="border-b-2 border-forest-700 pb-3 text-2xl font-bold text-wood-950 sm:text-3xl"
            >
              {group.category}
            </h2>
            <ul class="divide-y divide-wood-200">
              {group.dishes.map((dish) => (
                <MenuItem
                  name={dish.data.name}
                  description={dish.data.description}
                  price={dish.data.price}
                  allergens={dish.data.allergens}
                  available={dish.data.available}
                  houseSpecialty={dish.data.houseSpecialty}
                />
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="mt-16">
      <AllergenLegend codes={usedAllergens} />
    </div>
  </div>
</BaseLayout>
