---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const images = (await getCollection('gallery')).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title, 'de-AT'),
);

const categories = [...new Set(images.map((image) => image.data.category))];

const anchor = (value: string) =>
  value
    .toLowerCase()
    .replace(/ä/g, 'ae')
    .replace(/ö/g, 'oe')
    .replace(/ü/g, 'ue')
    .replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<BaseLayout
  title="Galerie"
  description="Bilder vom Schutzhaus am Hegerberg: Terrasse, Gastraum, Küche und der Blick über den Wienerwald."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Impressionen"
      title="Galerie"
      text="Ein paar Eindrücke vom Haus, aus der Küche und vom Blick, für den man heraufkommt."
    />

    {
      categories.length > 1 && (
        <div class="mt-8" data-gallery-filter>
          <h2 class="sr-only">Nach Kategorie filtern</h2>
          <div class="flex flex-wrap gap-2" role="group" aria-label="Kategorie-Filter">
            <button
              type="button"
              data-filter="all"
              aria-pressed="true"
              class="rounded-full border border-wood-300 px-4 py-2 text-sm font-semibold text-wood-800 transition hover:border-forest-600 hover:bg-forest-50 aria-pressed:border-forest-700 aria-pressed:bg-forest-700 aria-pressed:text-wood-50"
            >
              Alle
            </button>
            {categories.map((category) => (
              <button
                type="button"
                data-filter={anchor(category)}
                aria-pressed="false"
                class="rounded-full border border-wood-300 px-4 py-2 text-sm font-semibold text-wood-800 transition hover:border-forest-600 hover:bg-forest-50 aria-pressed:border-forest-700 aria-pressed:bg-forest-700 aria-pressed:text-wood-50"
              >
                {category}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      images.length > 0 ? (
        <ul
          class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"
          data-gallery
        >
          {images.map((image, index) => (
            <li
              data-category={anchor(image.data.category)}
              class:list={[
                'group',
                image.data.highlight && 'col-span-2 row-span-2',
              ]}
            >
              <button
                type="button"
                class="relative block h-full w-full overflow-hidden rounded-2xl bg-wood-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest-700"
                data-gallery-open
                data-index={index}
              >
                <img
                  src={image.data.image}
                  alt={image.data.imageAlt ?? image.data.title}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  class:list={[
                    'w-full object-cover transition duration-500 group-hover:scale-105',
                    image.data.highlight
                      ? 'aspect-square lg:aspect-auto lg:h-full'
                      : 'aspect-square',
                  ]}
                />
                <span
                  class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-wood-950/85 to-transparent p-4 pt-10 text-left"
                >
                  <span class="block text-sm font-semibold text-wood-50 sm:text-base">
                    {image.data.title}
                  </span>
                  <span class="mt-0.5 block text-xs text-wood-300">
                    {image.data.category}
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 rounded-2xl border border-wood-200 bg-wood-100 p-8 text-wood-700">
          Noch keine Bilder vorhanden. Fotos können im Redaktionsbereich unter
          „Galerie“ hochgeladen werden.
        </p>
      )
    }

    <p
      class="mt-10 hidden rounded-2xl border border-wood-200 bg-wood-100 p-6 text-wood-700"
      data-gallery-empty
    >
      In dieser Kategorie sind noch keine Bilder vorhanden.
    </p>
  </div>

  <!-- Lightbox -->
  <dialog
    data-lightbox
    class="max-h-none max-w-none bg-transparent p-0 backdrop:bg-wood-950/90 open:fixed open:inset-0 open:h-full open:w-full"
    aria-label="Bildansicht"
  >
    <div class="flex h-full w-full flex-col">
      <div class="flex items-center justify-between gap-4 p-4 text-wood-50">
        <p class="text-sm tabular-nums text-wood-300" data-lightbox-counter></p>
        <button
          type="button"
          data-lightbox-close
          class="grid size-11 place-items-center rounded-full bg-wood-50/10 transition hover:bg-wood-50/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wood-50"
        >
          <span class="sr-only">Schließen</span>
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>

      <div class="relative flex min-h-0 flex-1 items-center justify-center px-4">
        <button
          type="button"
          data-lightbox-prev
          class="absolute left-4 z-10 grid size-12 place-items-center rounded-full bg-wood-50/10 text-wood-50 transition hover:bg-wood-50/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wood-50"
        >
          <span class="sr-only">Vorheriges Bild</span>
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>

        <img
          data-lightbox-image
          src=""
          alt=""
          class="max-h-full max-w-full rounded-xl object-contain shadow-2xl"
        />

        <button
          type="button"
          data-lightbox-next
          class="absolute right-4 z-10 grid size-12 place-items-center rounded-full bg-wood-50/10 text-wood-50 transition hover:bg-wood-50/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wood-50"
        >
          <span class="sr-only">Nächstes Bild</span>
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <div class="p-6 text-center text-wood-100">
        <p class="font-display text-lg font-bold" data-lightbox-title></p>
        <p class="mx-auto mt-1 max-w-xl text-sm text-wood-300" data-lightbox-text></p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script
  type="application/json"
  data-gallery-data
  set:html={JSON.stringify(
    images.map((image) => ({
      image: image.data.image,
      alt: image.data.imageAlt ?? image.data.title,
      title: image.data.title,
      description: image.data.description ?? '',
    })),
  )}
  is:inline
/>

<script>
  type Entry = {
    image: string;
    alt: string;
    title: string;
    description: string;
  };

  const dataEl = document.querySelector<HTMLScriptElement>('[data-gallery-data]');
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dataEl && grid && dialog) {
    const entries: Entry[] = JSON.parse(dataEl.textContent ?? '[]');

    const imageEl = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-lightbox-title]')!;
    const textEl = dialog.querySelector<HTMLElement>('[data-lightbox-text]')!;
    const counterEl = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;

    // The lightbox order follows the currently visible selection.
    let visible: number[] = entries.map((_, i) => i);
    let position = 0;

    const show = (next: number) => {
      if (visible.length === 0) return;
      position = (next + visible.length) % visible.length;
      const entry = entries[visible[position]];
      imageEl.src = entry.image;
      imageEl.alt = entry.alt;
      titleEl.textContent = entry.title;
      textEl.textContent = entry.description;
      counterEl.textContent = `${position + 1} / ${visible.length}`;
    };

    for (const button of grid.querySelectorAll<HTMLButtonElement>(
      '[data-gallery-open]',
    )) {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.index);
        const slot = visible.indexOf(index);
        show(slot === -1 ? 0 : slot);
        dialog.showModal();
      });
    }

    dialog
      .querySelector('[data-lightbox-close]')
      ?.addEventListener('click', () => dialog.close());
    dialog
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(position + 1));
    dialog
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(position - 1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(position + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(position - 1);
      }
    });

    // A click on the backdrop closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Category filter
    const filter = document.querySelector<HTMLElement>('[data-gallery-filter]');
    const emptyNote = document.querySelector<HTMLElement>('[data-gallery-empty]');

    filter?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-filter]',
      );
      if (!button) return;

      const selected = button.dataset.filter;
      for (const other of filter.querySelectorAll<HTMLButtonElement>(
        '[data-filter]',
      )) {
        other.setAttribute(
          'aria-pressed',
          String(other.dataset.filter === selected),
        );
      }

      const nextVisible: number[] = [];
      const gridEntries = grid.querySelectorAll<HTMLElement>('[data-category]');
      gridEntries.forEach((element, index) => {
        const matches = selected === 'all' || element.dataset.category === selected;
        element.hidden = !matches;
        if (matches) nextVisible.push(index);
      });

      visible = nextVisible;
      if (emptyNote) emptyNote.classList.toggle('hidden', visible.length > 0);
    });
  }
</script>
