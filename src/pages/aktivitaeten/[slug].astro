---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourKarte from '../../components/TourKarte.astro';
import Hoehenprofil from '../../components/Hoehenprofil.astro';
import Tourstatistik from '../../components/Tourstatistik.astro';
import TourCard from '../../components/TourCard.astro';
import { ladeTouren } from '../../lib/touren';
import { formatDauer, formatDistanz } from '../../lib/gpx';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const touren = await ladeTouren();
  return touren.map((tour) => ({
    params: { slug: tour.eintrag.id },
    props: { tour, alle: touren },
  }));
}

const { tour, alle } = Astro.props;
const { data } = tour.eintrag;
const { daten } = tour;

const { Content } = await render(tour.eintrag);

const weitere = alle
  .filter((andere) => andere.eintrag.id !== tour.eintrag.id)
  .sort(
    (a, b) =>
      Number(b.eintrag.data.art === data.art) - Number(a.eintrag.data.art === data.art),
  )
  .slice(0, 3);

const start = data.start ?? site.name;
const artLabel = data.art === 'Mountainbike' ? 'Mountainbike-Tour' : 'Wanderung';

const kennzahlen = [
  { label: 'Länge', wert: formatDistanz(daten.distanzKm) },
  { label: 'Aufstieg', wert: `${daten.aufstieg} hm` },
  { label: 'Abstieg', wert: `${daten.abstieg} hm` },
  {
    label: data.art === 'Mountainbike' ? 'Fahrzeit' : 'Gehzeit',
    wert: formatDauer(tour.dauerMinuten),
  },
];

/** Strukturierte Daten – hilft Suchmaschinen, die Tour als Route zu erkennen. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseAction',
  name: data.titel,
  description: data.beschreibung,
  exerciseType: data.art === 'Mountainbike' ? 'Mountainbiking' : 'Hiking',
  distance: `${daten.distanzKm} km`,
  location: {
    '@type': 'Place',
    name: start,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: daten.linie[0][0],
      longitude: daten.linie[0][1],
    },
  },
};
---

<BaseLayout
  title={data.titel}
  description={`${artLabel} rund um den Hegerberg: ${formatDistanz(daten.distanzKm)}, ${daten.aufstieg} Höhenmeter, rund ${formatDauer(tour.dauerMinuten)}. ${data.beschreibung}`}
>
  <div class="container-page py-12 sm:py-16">
    <a
      href="/aktivitaeten/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-wald-700 underline underline-offset-4"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
      Alle Aktivitäten
    </a>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-wald-700 px-3 py-1 text-xs font-semibold text-holz-50">
        {artLabel}
      </span>
      <span class="rounded-full bg-holz-200 px-3 py-1 text-xs font-semibold text-holz-900">
        Schwierigkeit: {data.schwierigkeit}
      </span>
      {
        daten.rundtour && (
          <span class="rounded-full border border-holz-300 px-3 py-1 text-xs font-semibold text-holz-700">
            Rundtour
          </span>
        )
      }
    </div>

    <h1 class="mt-4 max-w-3xl text-3xl font-bold text-holz-950 sm:text-4xl">
      {data.titel}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-holz-700">
      {data.beschreibung}
    </p>

    {
      data.hinweis && (
        <p class="mt-6 max-w-2xl rounded-2xl border border-holz-300 bg-holz-100 px-5 py-4 text-sm text-holz-800">
          <strong class="font-semibold">Hinweis:</strong> {data.hinweis}
        </p>
      )
    }

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_20rem] lg:items-start">
      <div class="space-y-6">
        <TourKarte
          linie={daten.linie}
          bounds={daten.bounds}
          titel={data.titel}
          rundtour={daten.rundtour}
          gpx={data.gpx}
        />

        <Hoehenprofil
          profil={daten.profil}
          hoeheMin={daten.hoeheMin}
          hoeheMax={daten.hoeheMax}
          distanzKm={daten.distanzKm}
          titel={data.titel}
        />

        {
          data.bild && (
            <img
              src={data.bild}
              alt={data.bildAlt ?? ''}
              loading="lazy"
              decoding="async"
              class="w-full rounded-2xl object-cover shadow-lg"
            />
          )
        }

        <div class="prose-tour max-w-2xl text-base leading-relaxed text-holz-700">
          <Content />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28">
        <div class="card p-6">
          <h2 class="text-lg font-bold text-holz-950">Auf einen Blick</h2>
          <Tourstatistik class="mt-4" gross eintraege={kennzahlen} />

          <dl class="mt-6 space-y-3 border-t border-holz-200 pt-4 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-holz-500">
                Ausgangspunkt
              </dt>
              <dd class="mt-0.5 text-holz-800">{start}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-holz-500">
                Höhenlage
              </dt>
              <dd class="mt-0.5 tabular-nums text-holz-800">
                {daten.hoeheMin} – {daten.hoeheMax} m
              </dd>
            </div>
          </dl>

          <a
            href={data.gpx}
            download
            class="btn-primary mt-6 w-full"
            data-astro-prefetch="false"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14"></path>
            </svg>
            GPX herunterladen
          </a>
          <p class="mt-3 text-xs leading-relaxed text-holz-600">
            Die Datei lässt sich in Komoot, Outdooractive, OsmAnd oder auf einem
            GPS-Gerät öffnen.
          </p>
        </div>

        <div class="card bg-wald-50 p-6">
          <h2 class="text-lg font-bold text-holz-950">Einkehr am Ziel</h2>
          <p class="mt-2 text-sm leading-relaxed text-holz-700">
            Das Schutzhaus liegt direkt an der Strecke. Für größere Gruppen
            bitten wir um kurze Voranmeldung.
          </p>
          <a
            href={`tel:${site.telefon.replace(/\s/g, '')}`}
            class="mt-4 inline-block font-semibold text-wald-700 underline underline-offset-4"
          >
            {site.telefonAnzeige}
          </a>
        </div>
      </aside>
    </div>

    {
      weitere.length > 0 && (
        <section class="mt-20">
          <h2 class="text-2xl font-bold text-holz-950">Weitere Touren</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {weitere.map((andere) => (
              <TourCard
                href={andere.href}
                titel={andere.eintrag.data.titel}
                art={andere.eintrag.data.art}
                schwierigkeit={andere.eintrag.data.schwierigkeit}
                beschreibung={andere.eintrag.data.beschreibung}
                bild={andere.eintrag.data.bild}
                bildAlt={andere.eintrag.data.bildAlt}
                daten={andere.daten}
                dauerMinuten={andere.dauerMinuten}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />
</BaseLayout>

<style>
  /* Der Fließtext aus dem CMS bekommt hier seine Abstände. */
  .prose-tour :global(p) {
    margin-block: 1rem;
  }

  .prose-tour :global(h2) {
    margin-top: 2rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-holz-950);
  }

  .prose-tour :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-holz-950);
  }

  .prose-tour :global(ul) {
    margin-block: 1rem;
    list-style: disc;
    padding-left: 1.25rem;
  }

  .prose-tour :global(li) {
    margin-block: 0.35rem;
  }

  .prose-tour :global(a) {
    font-weight: 600;
    color: var(--color-wald-700);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose-tour :global(strong) {
    color: var(--color-holz-900);
  }
</style>
