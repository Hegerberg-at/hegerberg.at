---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourMap from '../../components/TourMap.astro';
import ElevationProfile from '../../components/ElevationProfile.astro';
import TourStats from '../../components/TourStats.astro';
import TourCard from '../../components/TourCard.astro';
import { loadTours } from '../../lib/tours';
import { formatDuration, formatDistance } from '../../lib/gpx';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const tours = await loadTours();
  return tours.map((tour) => ({
    params: { slug: tour.entry.id },
    props: { tour, all: tours },
  }));
}

const { tour, all } = Astro.props;
const { data } = tour.entry;
const tourData = tour.data;

const { Content } = await render(tour.entry);

const others = all
  .filter((other) => other.entry.id !== tour.entry.id)
  .sort(
    (a, b) =>
      Number(b.entry.data.type === data.type) - Number(a.entry.data.type === data.type),
  )
  .slice(0, 3);

const start = data.start ?? site.name;
const typeLabel = data.type === 'Mountainbike' ? 'Mountainbike-Tour' : 'Wanderung';

const stats = [
  { label: 'Länge', value: formatDistance(tourData.distanceKm) },
  { label: 'Aufstieg', value: `${tourData.ascent} hm` },
  { label: 'Abstieg', value: `${tourData.descent} hm` },
  {
    label: data.type === 'Mountainbike' ? 'Fahrzeit' : 'Gehzeit',
    value: formatDuration(tour.durationMinutes),
  },
];

/** Structured data – helps search engines recognise the tour as a route. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseAction',
  name: data.title,
  description: data.description,
  exerciseType: data.type === 'Mountainbike' ? 'Mountainbiking' : 'Hiking',
  distance: `${tourData.distanceKm} km`,
  location: {
    '@type': 'Place',
    name: start,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: tourData.line[0][0],
      longitude: tourData.line[0][1],
    },
  },
};
---

<BaseLayout
  title={data.title}
  description={`${typeLabel} rund um den Hegerberg: ${formatDistance(tourData.distanceKm)}, ${tourData.ascent} Höhenmeter, rund ${formatDuration(tour.durationMinutes)}. ${data.description}`}
  image={data.image}
>
  <div class="container-page py-12 sm:py-16">
    <a
      href="/aktivitaeten/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-forest-700 underline underline-offset-4"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
      Alle Aktivitäten
    </a>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-forest-700 px-3 py-1 text-xs font-semibold text-wood-50">
        {typeLabel}
      </span>
      <span class="rounded-full bg-wood-200 px-3 py-1 text-xs font-semibold text-wood-900">
        Schwierigkeit: {data.difficulty}
      </span>
      {
        tourData.roundTrip && (
          <span class="rounded-full border border-wood-300 px-3 py-1 text-xs font-semibold text-wood-700">
            Rundtour
          </span>
        )
      }
    </div>

    <h1 class="mt-4 max-w-3xl text-3xl font-bold text-wood-950 sm:text-4xl">
      {data.title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-wood-700">
      {data.description}
    </p>

    {
      data.note && (
        <p class="mt-6 max-w-2xl rounded-2xl border border-wood-300 bg-wood-100 px-5 py-4 text-sm text-wood-800">
          <strong class="font-semibold">Hinweis:</strong> {data.note}
        </p>
      )
    }

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_20rem] lg:items-start">
      <div class="space-y-6">
        <TourMap
          line={tourData.line}
          bounds={tourData.bounds}
          title={data.title}
          roundTrip={tourData.roundTrip}
          gpx={data.gpx}
        />

        <ElevationProfile
          profile={tourData.profile}
          elevationMin={tourData.elevationMin}
          elevationMax={tourData.elevationMax}
          distanceKm={tourData.distanceKm}
          title={data.title}
        />

        {
          data.image && (
            <img
              src={data.image}
              alt={data.imageAlt ?? ''}
              loading="lazy"
              decoding="async"
              class="w-full rounded-2xl object-cover shadow-lg"
            />
          )
        }

        <div class="prose-tour max-w-2xl text-base leading-relaxed text-wood-700">
          <Content />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28">
        <div class="card p-6">
          <h2 class="text-lg font-bold text-wood-950">Auf einen Blick</h2>
          <TourStats class="mt-4" large stats={stats} />

          <dl class="mt-6 space-y-3 border-t border-wood-200 pt-4 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-wood-500">
                Ausgangspunkt
              </dt>
              <dd class="mt-0.5 text-wood-800">{start}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-[0.14em] text-wood-500">
                Höhenlage
              </dt>
              <dd class="mt-0.5 tabular-nums text-wood-800">
                {tourData.elevationMin} – {tourData.elevationMax} m
              </dd>
            </div>
          </dl>

          <a
            href={data.gpx}
            download
            class="btn-primary mt-6 w-full"
            data-astro-prefetch="false"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14"></path>
            </svg>
            GPX herunterladen
          </a>
          <p class="mt-3 text-xs leading-relaxed text-wood-600">
            Die Datei lässt sich in Komoot, Outdooractive, OsmAnd oder auf einem
            GPS-Gerät öffnen.
          </p>
        </div>

        <div class="card bg-forest-50 p-6">
          <h2 class="text-lg font-bold text-wood-950">Einkehr am Ziel</h2>
          <p class="mt-2 text-sm leading-relaxed text-wood-700">
            Das Schutzhaus liegt direkt an der Strecke. Für größere Gruppen
            bitten wir um kurze Voranmeldung.
          </p>
          <a
            href={`tel:${site.phone.replace(/\s/g, '')}`}
            class="mt-4 inline-block font-semibold text-forest-700 underline underline-offset-4"
          >
            {site.phoneDisplay}
          </a>
        </div>
      </aside>
    </div>

    {
      others.length > 0 && (
        <section class="mt-20">
          <h2 class="text-2xl font-bold text-wood-950">Weitere Touren</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {others.map((other) => (
              <TourCard
                href={other.href}
                title={other.entry.data.title}
                type={other.entry.data.type}
                difficulty={other.entry.data.difficulty}
                description={other.entry.data.description}
                image={other.entry.data.image}
                imageAlt={other.entry.data.imageAlt}
                data={other.data}
                durationMinutes={other.durationMinutes}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />
</BaseLayout>

<style>
  /* The body text from the CMS gets its spacing here. */
  .prose-tour :global(p) {
    margin-block: 1rem;
  }

  .prose-tour :global(h2) {
    margin-top: 2rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-wood-950);
  }

  .prose-tour :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-wood-950);
  }

  .prose-tour :global(ul) {
    margin-block: 1rem;
    list-style: disc;
    padding-left: 1.25rem;
  }

  .prose-tour :global(li) {
    margin-block: 0.35rem;
  }

  .prose-tour :global(a) {
    font-weight: 600;
    color: var(--color-forest-700);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose-tour :global(strong) {
    color: var(--color-wood-900);
  }
</style>
