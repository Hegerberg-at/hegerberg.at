---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TourCard from '../../components/TourCard.astro';
import { loadTours } from '../../lib/tours';
import { formatDistance } from '../../lib/gpx';

const tours = await loadTours();

const mtb = tours.filter((tour) => tour.entry.data.type === 'Mountainbike');
const hiking = tours.filter((tour) => tour.entry.data.type === 'Wanderung');

const totalKm = tours.reduce((sum, tour) => sum + tour.data.distanceKm, 0);

const filters = [
  { value: 'all', label: 'Alle Touren', count: tours.length },
  { value: 'Mountainbike', label: 'Mountainbike', count: mtb.length },
  { value: 'Wanderung', label: 'Wandern', count: hiking.length },
].filter((entry) => entry.count > 0);
---

<BaseLayout
  title="Aktivitäten rund um den Hegerberg"
  description="Mountainbike-Touren und Wanderungen rund um den Hegerberg bei Stössing – mit Höhenprofil, Karte und GPX-Datei zum Mitnehmen."
>
  <div class="container-page py-16 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Unterwegs"
      title="Aktivitäten rund um den Hegerberg"
      text="Der Hegerberg ist ein guter Ausgangspunkt: Forststraßen fürs Rad, ruhige Waldwege zum Gehen und am Ende die Terrasse. Alle Touren gibt es als GPX-Datei zum Mitnehmen aufs Navi oder Handy."
    />

    {
      tours.length > 0 && (
        <p class="mt-6 text-sm text-wood-600">
          {tours.length}{' '}
          {tours.length === 1 ? 'Tour' : 'Touren'} · zusammen{' '}
          {formatDistance(Math.round(totalKm * 10) / 10)} · Start meist direkt beim
          Schutzhaus
        </p>
      )
    }

    {
      tours.length > 0 ? (
        <>
          {filters.length > 2 && (
            <div class="mt-8" data-tour-filter>
              <h2 class="sr-only">Nach Art filtern</h2>
              <div class="flex flex-wrap gap-2" role="group" aria-label="Art der Tour">
                {filters.map((entry, index) => (
                  <button
                    type="button"
                    data-filter={entry.value}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    class="rounded-full border border-wood-300 px-4 py-2 text-sm font-semibold text-wood-800 transition hover:border-forest-600 hover:bg-forest-50 aria-pressed:border-forest-700 aria-pressed:bg-forest-700 aria-pressed:text-wood-50"
                  >
                    {entry.label}
                    <span class="ml-1.5 tabular-nums opacity-70">{entry.count}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div
            class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            data-tours
          >
            {tours.map((tour) => (
              <div data-type={tour.entry.data.type} class="contents">
                <TourCard
                  href={tour.href}
                  title={tour.entry.data.title}
                  type={tour.entry.data.type}
                  difficulty={tour.entry.data.difficulty}
                  description={tour.entry.data.description}
                  image={tour.entry.data.image}
                  imageAlt={tour.entry.data.imageAlt}
                  data={tour.data}
                  durationMinutes={tour.durationMinutes}
                />
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="mt-10 rounded-2xl border border-wood-200 bg-wood-100 p-8 text-wood-700">
          Die Touren werden gerade zusammengestellt. Bald finden Sie hier
          Mountainbike-Runden und Wanderungen mit GPX-Dateien zum Herunterladen.
        </p>
      )
    }

    <section class="mt-20 grid gap-6 lg:grid-cols-2">
      <div class="card p-6 sm:p-8">
        <h2 class="text-xl font-bold text-wood-950">GPX-Dateien verwenden</h2>
        <p class="mt-3 text-sm leading-relaxed text-wood-700">
          Jede Tour lässt sich als GPX-Datei herunterladen. Die Datei kann in
          gängige Apps wie Komoot, Outdooractive, OsmAnd oder auf ein
          Fahrrad-Navi importiert werden – dort erscheint die Strecke dann als
          Route zum Nachfahren.
        </p>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="text-xl font-bold text-wood-950">Bitte beachten</h2>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-wood-700">
          <li>
            Die Angaben sind Richtwerte und ersetzen keine Wanderkarte. Wetter
            und Zustand der Wege bitte vorher prüfen.
          </li>
          <li>
            Die Wege führen über Forststraßen und durch bewirtschafteten Wald –
            Sperren und Beschilderung bitte beachten.
          </li>
          <li>
            Vor dem Losgehen ein Blick auf die
            <a
              href="/oeffnungszeiten/"
              class="font-semibold text-forest-700 underline underline-offset-2"
              >Öffnungszeiten</a
            >, damit die Einkehr am Ende auch klappt.
          </li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLElement>('[data-tour-filter]');
  const grid = document.querySelector<HTMLElement>('[data-tours]');

  filter?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button || !grid) return;

    const selected = button.dataset.filter;
    for (const other of filter.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
      other.setAttribute('aria-pressed', String(other.dataset.filter === selected));
    }

    for (const entry of grid.querySelectorAll<HTMLElement>('[data-type]')) {
      const matches = selected === 'all' || entry.dataset.type === selected;
      entry.classList.toggle('contents', matches);
      entry.classList.toggle('hidden', !matches);
    }
  });
</script>
