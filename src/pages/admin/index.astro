---
/**
 * Decap CMS – Redaktionsoberfläche.
 *
 * Liegt bewusst unter src/pages/, damit /admin/ auch im Dev-Server erreichbar
 * ist (Astro liefert für Ordner in public/ keinen Directory-Index aus). Der
 * Build erzeugt daraus eine statische dist/admin/index.html.
 *
 * Die Feldkonfiguration bleibt als reine YAML-Datei unter
 * public/admin/config.yml und wird von Decap zur Laufzeit geladen.
 */
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="config.yml" type="text/yaml" rel="cms-config-url" />
    <title>Redaktion – Schutzhaus am Hegerberg</title>
  </head>
  <body>
    <!-- Decap CMS. Der Login läuft über /oauth/ (siehe public/oauth/index.php). -->
    <script
      src="https://unpkg.com/decap-cms@^3.8.4/dist/decap-cms.js"
      is:inline></script>
  </body>
</html>
