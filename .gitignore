# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# Lockfile stays out of the repository on purpose: locally the packages are
# installed through the internal repo proxy of the City of Vienna, whose host
# ends up in bun.lock as the resolved registry URL. The GitHub runner cannot
# reach that host, so a committed bun.lock breaks the deploy.
bun.lock

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# OAuth credentials (uploaded by hand via FTP)
public/oauth/config.php

# SMTP credentials of the contact form (generated on deploy)
public/api/config.php

# PHPMailer and web-push – they only live on the server, see
# .github/workflows/php-libraries.yml
public/vendor/

# VAPID keys of the push notifications (generated on deploy)
public/api/push-config.php

# The subscribed devices. On the server they sit one level above
# public_html, locally they end up here – neither belongs in the repository.
push-daten/
public/api/push-daten/
